<Project Sdk="Microsoft.NET.Sdk">

  <!-- ============================================================
       对稿验证（T-28）—— 只引用跨平台的 LiteCut.Core，起得快、跑得净
       用法： cd 工具\对稿验证 && dotnet run -c Release
       退出码 0 = 全通过，1 = 有失败项。
       ============================================================ -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>ScriptAlignVerify</AssemblyName>
    <LangVersion>12.0</LangVersion>
    <StartupObject>ScriptAlignVerify.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\LiteCut.Core\LiteCut.Core.csproj" />
  </ItemGroup>

</Project>
