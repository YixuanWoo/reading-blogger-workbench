<Project Sdk="Microsoft.NET.Sdk">

  <!-- ============================================================
       自检（WorkbenchSelfCheck）- 工作台健康检查的「自动化检查」那一半

       这是什么：
         一个零依赖的控制台程序，只引用 LiteCut.Core，跑一组确定性的
         纯逻辑断言（文本相似度 / 时间轴合并 / 静音检测 / 包络 /
         转写稿导入 / 契约读写）。跑完打印「通过 N 项，失败 M 项」，
         失败时退出码 1，全过退出码 0。

       为什么要有它：
         本工程原先没有任何自动化检查，健康检查就只能编一遍看能不能过。
         加这一项是为了让「过没过」有行为层面的判据，而不只是编译。

       为什么不是单元测试框架：
         本项目不引入第三方依赖（董事会定的红线）。xUnit/NUnit 都是包，
         Microsoft.NET.Test.Sdk 也算。所以这里用最朴素的 assert 收集器。

       为什么 TargetFramework 是 net8.0：
         和 LiteCut.Core 保持一致（不带 -windows），保证自检本身也
         不会偷偷依赖 Windows 专有 API。

       注意：它不在 工作台.sln 里，走独立工程路径调用，
             不改解决方案结构。
       ============================================================ -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>LiteCut.SelfCheck</RootNamespace>
    <AssemblyName>WorkbenchSelfCheck</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- 自检输出里有中文：固定 UTF-8，别让控制台代码页把它变成乱码 -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\LiteCut.Core\LiteCut.Core.csproj" />
  </ItemGroup>

</Project>
