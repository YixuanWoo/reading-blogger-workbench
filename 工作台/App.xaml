<!-- ============================================================
     App.xaml - 应用程序启动定义
     XAML 是 WPF 的"界面描述语言"，不写逻辑，只描述长什么样。
     这个文件只放全局资源和应用级设置。
     ============================================================
     【这里故意不写 StartupUri】
       StartupUri 建的窗口由 WPF 框架在 OnStartup 返回之后创建，
       代码里拦不住。而我们要在"已经有工作台在跑"时干净地不建窗口
       （否则会闪一下再消失），所以主窗口改成在 App.xaml.cs 里手动创建。
     ============================================================ -->
<Application x:Class="LiteCut.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <!-- 全局配色：深色主题，所有窗口共用 -->
        <SolidColorBrush x:Key="BrushBackground" Color="#FF14161A"/>
        <SolidColorBrush x:Key="BrushPanel" Color="#FF1D2128"/>
        <SolidColorBrush x:Key="BrushBorder" Color="#FF333A45"/>
        <SolidColorBrush x:Key="BrushText" Color="#FFE8E6E3"/>
        <SolidColorBrush x:Key="BrushAccent" Color="#FFD4AF37"/>
        <SolidColorBrush x:Key="BrushWave" Color="#FF6BB3FF"/>
        <SolidColorBrush x:Key="BrushSelection" Color="#66D4AF37"/>
        <SolidColorBrush x:Key="BrushPlayhead" Color="#FFFF5566"/>
    
        <!-- ============================================================
             工作台全局资源：界面所有 page 共享
             ============================================================
             为什么放这里而不是主窗口里：
               XAML 的 {StaticResource} 在 InitializeComponent() 那一刻就解析，
               这时候页面还没挂到窗口树上 —— 若样式写在 Window.Resources，
               子页面单独构造时会抛"找不到资源"。放 App 级则全局可见。 -->

        <!-- ============================================================
             颜色定义：整个界面的配色集中在这里，改主题只用改这几行
             ============================================================ -->
        <SolidColorBrush x:Key="BgDeep"    Color="#FF0E1013"/>
        <SolidColorBrush x:Key="BgNav"     Color="#FF14171C"/>
        <SolidColorBrush x:Key="BgCard"    Color="#FF1A1E24"/>
        <SolidColorBrush x:Key="BgInput"   Color="#FF232830"/>
        <SolidColorBrush x:Key="Border"    Color="#FF2A3038"/>
        <SolidColorBrush x:Key="TextMain"  Color="#FFE6E9EF"/>
        <SolidColorBrush x:Key="TextDim"   Color="#FF8B93A1"/>
        <SolidColorBrush x:Key="TextFaint" Color="#FF78828F"/>
        <SolidColorBrush x:Key="Accent"    Color="#FF3B82F6"/>
        <SolidColorBrush x:Key="AccentHot" Color="#FF2563EB"/>
        <SolidColorBrush x:Key="Danger"    Color="#FFEF4444"/>
        <SolidColorBrush x:Key="Ok"        Color="#FF22C55E"/>
        <SolidColorBrush x:Key="Warn"      Color="#FFF59E0B"/>

        <!-- 导航按钮 -->
        <Style x:Key="NavBtn" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="8,2,8,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="7" Padding="14,0,10,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" x:Name="ico" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                           FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                <Border Grid.Column="2" x:Name="badge" Background="#FF2A3038" CornerRadius="4"
                                        Padding="5,1,5,1" VerticalAlignment="Center" Visibility="Collapsed">
                                    <TextBlock Text="规划中" FontSize="9" Foreground="{StaticResource TextFaint}"/>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF232B36"/>
                                <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF1E242C"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#FF4A5159"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 步骤按钮（顶部流程条） -->
        <Style x:Key="StepBtn" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="14,7,14,7">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="num" Background="#FF2A3038" CornerRadius="9"
                                        Width="18" Height="18" Margin="0,0,7,0">
                                    <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                               FontSize="10" Foreground="#FF8B93A1"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF1D3A5F"/>
                                <Setter TargetName="num" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF1E242C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 通用按钮 -->
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BgInput}"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="Padding" Value="14,7,14,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF2C333D"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 主按钮（蓝色实心） -->
        <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="{StaticResource AccentHot}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Accent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 危险按钮 -->
        <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Foreground" Value="{StaticResource Danger}"/>
            <Setter Property="BorderBrush" Value="#FF4A2222"/>
        </Style>

        <!-- 卡片 -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BgCard}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
        </Style>

        <!-- 文本框 -->
        <Style x:Key="Tbx" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource BgInput}"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6,8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>

        <!-- ============================================================
             ComboBox 深色（V1.9.10 整个换模板）
             ============================================================
             为什么要整个模板换掉：以前只设了 Background/Foreground，
             但 WPF 的 ComboBox 默认模板里，"按下去弹出来的那个列表"是
             系统级白底（Popup 里一层白 Border），设颜色根本够不着它 ——
             用户看到的就是白底配灰字，没法看。
             这个模板把三件东西全换成深色：收起时的按钮面、弹出的列表、列表项。
             全项目 4 个下拉（节奏 / 导出方式 / 分辨率 / 画质）都是普通选择式，
             没有可输入的，所以模板不处理可编辑分支。 -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="5"
                                Margin="5,2" Padding="10,6">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF2C3A4E"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF1D3A5F"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource TextFaint}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,6,10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <!-- 按钮面：整个下拉框其实是颗 ToggleButton，点了开/关列表 -->
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="bd" Background="{StaticResource BgInput}"
                                                BorderBrush="{StaticResource Border}" BorderThickness="1"
                                                CornerRadius="6">
                                            <TextBlock Text="▾" FontSize="11"
                                                       Foreground="{StaticResource TextDim}"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                                       Margin="0,0,9,0"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="BorderBrush" Value="#FF465263"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <!-- 收起时显示的选中文字。IsHitTestVisible=False 让点击穿透到下面的按钮 -->
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Left" VerticalAlignment="Center"
                                              IsHitTestVisible="False"/>

                            <!-- 弹出的列表：以前这里是一层系统白 Border，就是白底的元凶 -->
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom" AllowsTransparency="True"
                                   PopupAnimation="Fade" Focusable="False">
                                <Border Background="#FF1E242E" BorderBrush="#FF3E4A5B"
                                        BorderThickness="1" CornerRadius="8" Padding="0,4"
                                        Margin="0,4,0,0" MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="330">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="14" ShadowDepth="2"
                                                          Opacity="0.45" Color="#FF000000"/>
                                    </Border.Effect>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- DataGrid 深色 -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource BgCard}"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="{StaticResource BgCard}"/>
            <Setter Property="AlternatingRowBackground" Value="#FF1D2128"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="SelectionMode" Value="Extended"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="RowHeight" Value="30"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#FF1F242B"/>
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="Padding" Value="8,6,8,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FF1D3A5F"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    
    </Application.Resources>
</Application>
