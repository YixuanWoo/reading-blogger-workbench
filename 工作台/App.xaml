<!-- ============================================================
     App.xaml - 应用程序启动定义
     XAML 是 WPF 的"界面描述语言"，不写逻辑，只描述长什么样。
     这个文件只放全局资源和应用级设置。
     ============================================================
     【这里故意不写 StartupUri】
       StartupUri 建的窗口由 WPF 框架在 OnStartup 返回之后创建，
       代码里拦不住。而我们要在"已经有工作台在跑"时干净地不建窗口
       （否则会闪一下再消失），所以主窗口改成在 App.xaml.cs 里手动创建。
     ============================================================ -->
<Application x:Class="LiteCut.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <!-- 全局配色：深色主题，所有窗口共用 -->
        <SolidColorBrush x:Key="BrushBackground" Color="#FF14161A"/>
        <SolidColorBrush x:Key="BrushPanel" Color="#FF1D2128"/>
        <SolidColorBrush x:Key="BrushBorder" Color="#FF333A45"/>
        <SolidColorBrush x:Key="BrushText" Color="#FFE8E6E3"/>
        <SolidColorBrush x:Key="BrushAccent" Color="#FFD4AF37"/>
        <SolidColorBrush x:Key="BrushWave" Color="#FF6BB3FF"/>
        <SolidColorBrush x:Key="BrushSelection" Color="#66D4AF37"/>
        <SolidColorBrush x:Key="BrushPlayhead" Color="#FFFF5566"/>
    
        <!-- ============================================================
             工作台全局资源：界面所有 page 共享
             ============================================================
             为什么放这里而不是主窗口里：
               XAML 的 {StaticResource} 在 InitializeComponent() 那一刻就解析，
               这时候页面还没挂到窗口树上 —— 若样式写在 Window.Resources，
               子页面单独构造时会抛"找不到资源"。放 App 级则全局可见。 -->

        <!-- ============================================================
             ★ 配色总表（V1.18.0 主题化）
             ============================================================
             这里的颜色值是「夜空黑」（原来的深色配色）。
             页面里**一律引用这些 key，不要写 #RRGGBB** —— 写死的颜色
             换了主题不会变，白天主题下会变成一块扎眼的深色。

             切换主题的机制：不换笔，只改笔里的颜色。
               ThemeManager.Apply("day") → 逐支 SolidColorBrush 改 Color，
               所有引用同一支笔的地方自动重画（见 Theming/ThemeManager.cs）。
             ★ 所以**不要给这些笔加 Freeze**，冻结之后改不动。

             「晨光白」的色值不写在这里，写在 ThemeManager.Light 表里。
             加新颜色：这里加一支笔（夜空黑值）+ ThemeManager 加一条白天值。
             ============================================================ -->

        <!-- ===== 底层与面板（由深到浅） ===== -->
        <SolidColorBrush x:Key="BgDeep"     Color="#FF0E1013"/>   <!-- 窗口最底 -->
        <SolidColorBrush x:Key="BgShell"    Color="#FF12151A"/>   <!-- 页面底 / 顶栏 / 状态栏 -->
        <SolidColorBrush x:Key="BgNav"      Color="#FF14171C"/>   <!-- 左侧导航 -->
        <SolidColorBrush x:Key="BgNavFoot"  Color="#FF171B21"/>   <!-- 导航底部信息盒 -->
        <SolidColorBrush x:Key="BgCard"     Color="#FF1A1E24"/>   <!-- 卡片 -->
        <SolidColorBrush x:Key="BgCardAlt"  Color="#FF1B1F26"/>   <!-- 次一级卡片 / 胶囊 -->
        <SolidColorBrush x:Key="BgChip"     Color="#FF232A33"/>   <!-- 小胶囊 / 分段控件 -->
        <SolidColorBrush x:Key="BgInput"    Color="#FF232830"/>   <!-- 输入框 -->
        <SolidColorBrush x:Key="BgInset"    Color="#FF141A22"/>   <!-- 内凹区 -->
        <SolidColorBrush x:Key="BgInset2"   Color="#FF101318"/>   <!-- 内凹区（更深一档） -->
        <SolidColorBrush x:Key="BgRow"      Color="#FF0F1216"/>   <!-- 行底（录音台判词区） -->
        <SolidColorBrush x:Key="BgTopStrip" Color="#FF11141A"/>   <!-- 顶部细条（录音台标题栏） -->
        <SolidColorBrush x:Key="BgPanelDeep" Color="#FF161A20"/>  <!-- 深色小盒 -->
        <SolidColorBrush x:Key="BorderFaint" Color="#FF39414C"/>  <!-- 极淡的描边 / 空闲圆点 -->
        <SolidColorBrush x:Key="ItemSelBg"  Color="#FF1E2733"/>   <!-- 列表选中项 -->
        <SolidColorBrush x:Key="ItemHoverBg" Color="#FF1B1F25"/>  <!-- 列表悬停项 -->
        <SolidColorBrush x:Key="BgHead"     Color="#FF1F242B"/>   <!-- 表头 -->
        <SolidColorBrush x:Key="BgPreview"  Color="#FF0B0E13"/>   <!-- 视频预览底（两套主题都深） -->
        <SolidColorBrush x:Key="Divider"    Color="#FF1E232B"/>   <!-- 细分隔线 -->
        <SolidColorBrush x:Key="Divider2"   Color="#FF22272F"/>   <!-- 细分隔线（2） -->
        <SolidColorBrush x:Key="DividerFaint" Color="#FF252A31"/> <!-- 极淡的分组线（导航分组） -->
        <SolidColorBrush x:Key="Border"     Color="#FF2A3038"/>
        <SolidColorBrush x:Key="BorderStrong" Color="#FF3A424E"/>
        <SolidColorBrush x:Key="BorderMid"  Color="#FF6B7684"/>
        <SolidColorBrush x:Key="BorderHover" Color="#FF465263"/>
        <SolidColorBrush x:Key="HoverBg"    Color="#FF1E242C"/>   <!-- 悬停底 -->
        <SolidColorBrush x:Key="HoverBg2"   Color="#FF242C36"/>   <!-- 悬停底（行） -->
        <SolidColorBrush x:Key="BtnHoverBg" Color="#FF2C333D"/>   <!-- 按钮悬停底 -->
        <SolidColorBrush x:Key="NavSelBg"   Color="#FF232B36"/>   <!-- 导航选中 -->
        <SolidColorBrush x:Key="SelBg"      Color="#FF1D3A5F"/>   <!-- 选中行 / 选中项 -->
        <SolidColorBrush x:Key="ItemHover"  Color="#FF2C3A4E"/>   <!-- 下拉项悬停 -->
        <SolidColorBrush x:Key="PopupBg"    Color="#FF1E242E"/>   <!-- 下拉弹层 -->
        <SolidColorBrush x:Key="PopupBorder" Color="#FF3E4A5B"/>

        <!-- ===== 文字（由深到浅；这里"深"指亮） ===== -->
        <SolidColorBrush x:Key="TextMain"    Color="#FFE6E9EF"/>
        <SolidColorBrush x:Key="TextBright"  Color="#FFF4F2EC"/>  <!-- 最亮：标题 / 当前句 -->
        <SolidColorBrush x:Key="TextSoft"    Color="#FFC9D2DE"/>
        <SolidColorBrush x:Key="TextMainAlt" Color="#FFE8E6E3"/>
        <SolidColorBrush x:Key="TextDim"     Color="#FF8B93A1"/>
        <SolidColorBrush x:Key="TextFaint"   Color="#FF78828F"/>
        <SolidColorBrush x:Key="TextMuted"   Color="#FF5A6169"/>
        <SolidColorBrush x:Key="TextMuted2"  Color="#FF59616C"/>
        <SolidColorBrush x:Key="TextNote"    Color="#FF6E7783"/>
        <SolidColorBrush x:Key="TextGhost"   Color="#FF4E555F"/>
        <SolidColorBrush x:Key="TextGhost2"  Color="#FF5F6772"/>
        <SolidColorBrush x:Key="TextFaintAlt" Color="#FF9AA3B0"/>
        <SolidColorBrush x:Key="TextWarm"    Color="#FF8E8280"/>
        <SolidColorBrush x:Key="TextDisabled" Color="#FF4A5159"/>
        <SolidColorBrush x:Key="TextOnAccent" Color="#FFFFFFFF"/> <!-- 彩色按钮上的字 -->
        <SolidColorBrush x:Key="OnOverlay"   Color="#FFFFFFFF"/>  <!-- 压在视频/图片上的字 -->
        <SolidColorBrush x:Key="OnColorDark" Color="#FF0E1013"/>  <!-- 亮色块上的对钩 -->

        <!-- ===== 强调 / 语义色 ===== -->
        <SolidColorBrush x:Key="Accent"      Color="#FF3B82F6"/>
        <SolidColorBrush x:Key="AccentHot"   Color="#FF2563EB"/>
        <SolidColorBrush x:Key="Accent2"     Color="#FF22D3EE"/>  <!-- 次强调（青） -->
        <SolidColorBrush x:Key="AccentSoftBg"  Color="#333B82F6"/>
        <SolidColorBrush x:Key="AccentSoftBg2" Color="#2A3B82F6"/>
        <SolidColorBrush x:Key="Danger"      Color="#FFEF4444"/>
        <SolidColorBrush x:Key="DangerBorder" Color="#FF4A2222"/>
        <SolidColorBrush x:Key="Ok"          Color="#FF22C55E"/>
        <SolidColorBrush x:Key="Warn"        Color="#FFF59E0B"/>
        <SolidColorBrush x:Key="WarnHot"     Color="#FFEA580C"/>
        <SolidColorBrush x:Key="RecRed"      Color="#FFC7443A"/>
        <SolidColorBrush x:Key="KeepGreen"   Color="#FF2C6E49"/>
        <SolidColorBrush x:Key="Gold"        Color="#FFD4AF37"/>
        <SolidColorBrush x:Key="InfoBg"      Color="#FF182636"/>
        <SolidColorBrush x:Key="InfoBorder"  Color="#FF2F4A6B"/>
        <SolidColorBrush x:Key="InfoText"    Color="#FFBBD4F0"/>
        <SolidColorBrush x:Key="WarnBannerBg" Color="#FF2A2413"/>
        <SolidColorBrush x:Key="InsertBg"    Color="#FF1F3A2A"/>
        <SolidColorBrush x:Key="InsertCardBg" Color="#FF101A22"/>

        <!-- ===== 时间轴 / 波形 ===== -->
        <SolidColorBrush x:Key="WaveBlockNormal" Color="#FF3A6BA5"/>
        <SolidColorBrush x:Key="WaveBlockSel"    Color="#FFD4AF37"/>
        <SolidColorBrush x:Key="WaveBlockBad"    Color="#FFB03336"/>
        <SolidColorBrush x:Key="WaveBlockBorder" Color="#FF14161A"/>
        <SolidColorBrush x:Key="WaveBlockLabel"  Color="#FFFFFFFF"/>

        <!-- ===== 暗底上的半透明白（白天会换成半透明黑，否则看不见） ===== -->
        <SolidColorBrush x:Key="WhiteSoftBg"      Color="#14FFFFFF"/>
        <SolidColorBrush x:Key="WhiteSoftBg2"     Color="#0FFFFFFF"/>
        <SolidColorBrush x:Key="WhiteHairline"    Color="#22FFFFFF"/>
        <SolidColorBrush x:Key="WhiteHoverBorder" Color="#55FFFFFF"/>
        <SolidColorBrush x:Key="WhiteSoftBorder"  Color="#2EFFFFFF"/>
        <SolidColorBrush x:Key="TextOnDarkSoft"   Color="#D9FFFFFF"/>
        <SolidColorBrush x:Key="TextOnDarkDim"    Color="#99FFFFFF"/>

        <!-- ===== 其它 ===== -->
        <SolidColorBrush x:Key="ShadowColor" Color="#FF000000"/>
        <SolidColorBrush x:Key="OverlayBg"   Color="#AA000000"/>
        <SolidColorBrush x:Key="OverlayBg2"  Color="#B3000000"/>
        <SolidColorBrush x:Key="Transparent0" Color="#00000000"/>

        <!-- Color 类型的资源（ColorAnimation / DropShadowEffect 要 Color 不是 Brush） -->
        <Color x:Key="WarnHotColor">#FFEA580C</Color>
        <Color x:Key="BorderColor">#FF2A3038</Color>
        <Color x:Key="ShadowColorValue">#FF000000</Color>

        <!-- ===== 打卡热力图色阶 ===== -->
        <SolidColorBrush x:Key="HeatEmpty"    Color="#FF131820"/>
        <SolidColorBrush x:Key="HeatStroke"   Color="#FF232A33"/>
        <SolidColorBrush x:Key="Heat1"        Color="#FF8A6A1E"/>
        <SolidColorBrush x:Key="Heat1Stroke"  Color="#FF6B5316"/>
        <SolidColorBrush x:Key="Heat2"        Color="#FFC99A2E"/>
        <SolidColorBrush x:Key="Heat2Stroke"  Color="#FFA87F22"/>
        <SolidColorBrush x:Key="Heat3"        Color="#FFE8B54A"/>
        <SolidColorBrush x:Key="Heat3Stroke"  Color="#FFC99A2E"/>
        <SolidColorBrush x:Key="TodayRing"    Color="#FF9A9890"/>
        <SolidColorBrush x:Key="HeatLabel"    Color="#FF6E6C66"/>

        <!-- 导航按钮 -->
        <Style x:Key="NavBtn" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="8,2,8,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="7" Padding="14,0,10,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" x:Name="ico" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                           FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                <Border Grid.Column="2" x:Name="badge" Background="{DynamicResource Border}" CornerRadius="4"
                                        Padding="5,1,5,1" VerticalAlignment="Center" Visibility="Collapsed">
                                    <TextBlock Text="规划中" FontSize="9" Foreground="{DynamicResource TextFaint}"/>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource NavSelBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource TextDisabled}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 步骤按钮（顶部流程条） -->
        <Style x:Key="StepBtn" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="14,7,14,7">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="num" Background="{DynamicResource Border}" CornerRadius="9"
                                        Width="18" Height="18" Margin="0,0,7,0">
                                    <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                               FontSize="10" Foreground="{DynamicResource TextDim}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SelBg}"/>
                                <Setter TargetName="num" Property="Background" Value="{DynamicResource Accent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 通用按钮 -->
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BgInput}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="Padding" Value="14,7,14,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource BtnHoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 主按钮（蓝色实心） -->
        <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="{DynamicResource AccentHot}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Accent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 危险按钮 -->
        <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DangerBorder}"/>
        </Style>

        <!-- 卡片 -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BgCard}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
        </Style>

        <!-- 文本框 -->
        <Style x:Key="Tbx" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource BgInput}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6,8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextMain}"/>
        </Style>

        <!-- ============================================================
             ComboBox 深色（V1.9.10 整个换模板）
             ============================================================
             为什么要整个模板换掉：以前只设了 Background/Foreground，
             但 WPF 的 ComboBox 默认模板里，"按下去弹出来的那个列表"是
             系统级白底（Popup 里一层白 Border），设颜色根本够不着它 ——
             用户看到的就是白底配灰字，没法看。
             这个模板把三件东西全换成深色：收起时的按钮面、弹出的列表、列表项。
             全项目 4 个下拉（节奏 / 导出方式 / 分辨率 / 画质）都是普通选择式，
             没有可输入的，所以模板不处理可编辑分支。 -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="5"
                                Margin="5,2" Padding="10,6">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ItemHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SelBg}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource TextFaint}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,6,10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <!-- 按钮面：整个下拉框其实是颗 ToggleButton，点了开/关列表 -->
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="bd" Background="{DynamicResource BgInput}"
                                                BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                                CornerRadius="6">
                                            <TextBlock Text="▾" FontSize="11"
                                                       Foreground="{DynamicResource TextDim}"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                                       Margin="0,0,9,0"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource BorderHover}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <!-- 收起时显示的选中文字。IsHitTestVisible=False 让点击穿透到下面的按钮 -->
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Left" VerticalAlignment="Center"
                                              IsHitTestVisible="False"/>

                            <!-- 弹出的列表：以前这里是一层系统白 Border，就是白底的元凶 -->
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom" AllowsTransparency="True"
                                   PopupAnimation="Fade" Focusable="False">
                                <Border Background="{DynamicResource PopupBg}" BorderBrush="{DynamicResource PopupBorder}"
                                        BorderThickness="1" CornerRadius="8" Padding="0,4"
                                        Margin="0,4,0,0" MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="330">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="14" ShadowDepth="2"
                                                          Opacity="0.45" Color="{StaticResource ShadowColorValue}"/>
                                    </Border.Effect>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- DataGrid 深色 -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{DynamicResource BgCard}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="{DynamicResource BgCard}"/>
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource BrushPanel}"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="SelectionMode" Value="Extended"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="RowHeight" Value="30"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource BgHead}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
            <Setter Property="Padding" Value="8,6,8,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelBg}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    
    </Application.Resources>
</Application>
