<Project Sdk="Microsoft.NET.Sdk">

  <!-- ============================================================
       翊瑄的工作台 (LiteCut) - 工程定义文件
       这个文件告诉编译器：这是什么程序、用哪个 .NET 版本、
       引用哪些第三方库。
       平时基本不用改它；只有加第三方库时才需要动。
       ============================================================ -->

  <PropertyGroup>
    <!-- OutputType=WinExe 表示这是一个 Windows 图形界面程序（不是控制台程序） -->
    <OutputType>WinExe</OutputType>

    <!-- 目标框架：net8.0-windows = .NET 8 + Windows 桌面支持（WPF 必须） -->
    <TargetFramework>net8.0-windows</TargetFramework>

    <!-- UseWPF=true 表示启用 WPF（界面框架） -->
    <UseWPF>true</UseWPF>

    <!-- 根命名空间：所有类的"姓氏"，代码里 namespace LiteCut 就是这么来的 -->
    <RootNamespace>LiteCut</RootNamespace>

    <!-- 生成的 exe 文件名 -->
    <AssemblyName>LiteCut</AssemblyName>

    <!-- ============================================================
         版本号 —— 与 文档\更新日志.md 里的 Vx.y.z 必须对齐
         以前这里没写字版本，程序集一直用默认的 1.0.0.0，
         导致"日志里写着 V1.1.x，exe 右键属性却永远是 1.0.0.0"，
         排查问题时没法靠版本号确认用户手上跑的是哪一版。
         从 V1.1.9 起两边同步：改日志的版本号，就改这里的 Version。

         ★ V1.9.10 的"10"不能写成"1"：Version 是字符串原样进
           ProductVersion，末尾的 0 不会被自动去掉 —— 但如果手滑
           写成 1.9.1，日志和 exe 对不上，排查时又少一条证据。
         ============================================================ -->
    <Version>1.16.1</Version>

    <!-- ============================================================
         exe 图标 —— 资源管理器 / 任务栏 / Alt+Tab 显示的就是它
         源文件（矢量）在 资源\图标\svg\C-时间轴.svg，
         成品 ico 由 资源\图标\导出ico.js 一键生成。
         注意：WPF 的**窗口标题栏**不吃 ApplicationIcon，要在 App.xaml.cs 里另行赋值。
         ============================================================ -->
    <ApplicationIcon>..\资源\图标\app.ico</ApplicationIcon>

    <!-- 是否允许可空引用类型（写 string? 表示"可能为空"） -->
    <Nullable>enable</Nullable>

    <!-- 关闭隐式 using：每个文件的 using 都手写，方便初学者看懂引用了什么 -->
    <ImplicitUsings>disable</ImplicitUsings>

    <!-- DPI 感知清单：让高分屏上界面文字不模糊 -->
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- 打包单文件 exe 时的相关选项（在 build.ps1 里通过命令行覆盖） -->
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- ============================================================
       把图标再嵌一份到程序集里
       为什么同一个图标要写两次：
         ApplicationIcon  → 只进 exe 的 Win32 资源（资源管理器/任务栏看它）
         下面这条 Resource → 进程序集资源（给 WPF 的 pack:// URI 用，
                              App.xaml.cs 靠它把图标挂到窗口标题栏）
       Link="app.ico" 是必须的：带 ..\ 和中文目录的 Include，
       不加 Link 会让 Logo 的逻辑名变成一长串编码路径，引用时容易对不上。
       ============================================================ -->
  <ItemGroup>
    <Resource Include="..\资源\图标\app.ico" Link="app.ico" />
  </ItemGroup>

  <!-- 第三方库引用：NAudio 负责音频的读取、播放、导出 -->
  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <!-- ============================================================
       项目引用：工作台核心库（跨平台逻辑层）

       数据契约、Agent 客户端、流水线编排都放 LiteCut.Core。
       这一层不带 Windows 依赖（TargetFramework 是 net8.0，
       不是 net8.0-windows），所以将来迁到 macOS 时原样可用。

       分工：
         轻剪（本文件所在的 WPF 程序） = 界面 + 音频引擎
         LiteCut.Core                  = 跨平台的"大脑"
       ============================================================ -->
  <ItemGroup>
    <ProjectReference Include="..\LiteCut.Core\LiteCut.Core.csproj" />
  </ItemGroup>

</Project>
