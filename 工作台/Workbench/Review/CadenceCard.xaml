<!-- ============================================================
     CadenceCard.xaml - ★ V1.15.0 主图卡：更新节奏
     ============================================================
     【它为什么单独做成一个控件（而不是直接写在账号页里）】
       主图那个位置是"最贵"的 —— 阶段一变就要换内容：
         0~10 支   → 更新节奏（就是现在这张）
         10~30 支  → 哪一类内容行（播放/完播分布）
         30 支以上 → 涨粉速度曲线
       所以账号页是用一个 ContentControl 装着它的：**换主图 = 换一个控件**，
       不用去改账号页的布局。见 AccountReviewView 的 MainChartHost。

     【口气：只陈述，不评判（硬规矩）】
       ① 整张卡只有两个色系（金 = 发了 / 暗灰 = 没发），刻意不用红；
       ② 三个读数**谁都不上色** —— 最刺眼的"当前空档"也跟别的数一样静静摆着；
       ③ 不弹窗、不催、不用"目标/落后/加油"这类话术。
       一旦它开始催人，人就会开始讨厌打开这一页。
     ============================================================ -->
<UserControl x:Class="LiteCut.Workbench.Review.CadenceCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:LiteCut.Workbench.Controls"
             Background="Transparent">
    <Border Background="{StaticResource BgCard}"
            BorderBrush="{StaticResource Border}" BorderThickness="1"
            CornerRadius="10" Padding="16,14,16,12">
        <StackPanel>

            <!-- ============ 标题行：左标题 / 右时间窗 ============ -->
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            VerticalAlignment="Top" Margin="12,2,0,0">
                    <TextBlock Text="看" FontSize="11" VerticalAlignment="Center"
                               Foreground="{StaticResource TextDim}" Margin="0,0,5,0"/>
                    <ComboBox x:Name="PickRange" Width="104" FontSize="12"
                              VerticalAlignment="Center"
                              SelectionChanged="PickRange_SelectionChanged"/>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="更新节奏" FontSize="15" FontWeight="SemiBold" Foreground="White"/>
                    <TextBlock Text="一天一格 · 颜色越深，当天发得越多 · 全自动，一个字都不用填"
                               FontSize="11" Margin="0,3,0,0"
                               Foreground="{StaticResource TextFaint}"/>
                </StackPanel>
            </DockPanel>

            <!-- ============ 热力图本体 ============ -->
            <ctl:CadenceHeatmap x:Name="Chart" Margin="0,14,0,0"/>

            <!-- ============ 三个读数 ============ -->
            <Border Height="1" Background="{StaticResource Border}" Margin="0,16,0,0"/>

            <UniformGrid Columns="3" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock x:Name="TxtCount" FontSize="22" FontWeight="SemiBold"
                               Foreground="{StaticResource TextMain}" Text="—"/>
                    <TextBlock x:Name="LblCount" FontSize="11" Margin="0,3,0,0"
                               Foreground="{StaticResource TextFaint}"/>
                    <TextBlock x:Name="FootCount" FontSize="10.5" Margin="0,2,0,0"
                               Foreground="#FF5A6169"/>
                </StackPanel>

                <StackPanel>
                    <TextBlock x:Name="TxtStreak" FontSize="22" FontWeight="SemiBold"
                               Foreground="{StaticResource TextMain}" Text="—"/>
                    <TextBlock x:Name="LblStreak" FontSize="11" Margin="0,3,0,0"
                               Foreground="{StaticResource TextFaint}"/>
                    <TextBlock x:Name="FootStreak" FontSize="10.5" Margin="0,2,0,0"
                               Foreground="#FF5A6169"/>
                </StackPanel>

                <StackPanel>
                    <TextBlock x:Name="TxtGap" FontSize="22" FontWeight="SemiBold"
                               Foreground="{StaticResource TextMain}" Text="—"/>
                    <TextBlock x:Name="LblGap" FontSize="11" Margin="0,3,0,0"
                               Foreground="{StaticResource TextFaint}"/>
                    <TextBlock x:Name="FootGap" FontSize="10.5" Margin="0,2,0,0"
                               Foreground="#FF5A6169"/>
                </StackPanel>
            </UniformGrid>

            <!-- ============ 图例 + 那句"口气" ============ -->
            <DockPanel Margin="0,14,0,0">
                <StackPanel x:Name="Legend" DockPanel.Dock="Right" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="12,0,0,0"/>

                <TextBlock x:Name="TxtTone" FontSize="11" TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextDim}"
                           Text="它只陈述，不评判 —— 不变红、不弹窗、不催你。"/>
            </DockPanel>

            <TextBlock x:Name="TxtHint" FontSize="11" Margin="0,8,0,0"
                       TextWrapping="Wrap" Visibility="Collapsed"
                       Foreground="#FF8A7A4A"/>
        </StackPanel>
    </Border>
</UserControl>
