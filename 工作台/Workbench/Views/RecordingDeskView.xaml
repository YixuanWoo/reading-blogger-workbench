<!-- ============================================================
     RecordingDeskView.xaml - 录音台（V1.16.2 三栏 + 底部录音台）
     ============================================================
     【布局】
       左：文案选择区（整篇稿子，按录音范围分块：绿=已录 / 蓝=选中 / 金=待确认）
       中：提词区（大字，念的时候就盯这里）
       右：已录列表（一条一条往下长：音频 1、音频 2……）
       下：录音台（体检结论 / 电平 / 波形 / 计时 / 按钮）

     【一条录音 = 一块】
       块的标题写「音频 N · 14.3s」，不写"第几段第几句"；
       块内所有句子同一个底色，Shift 只在延长/缩短这一块，不会出现"光标块"。
       ============================================================ -->
<UserControl x:Class="LiteCut.Workbench.Views.RecordingDeskView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rd="clr-namespace:LiteCut.Workbench.RecordingDesk"
             Background="{StaticResource BgDeep}"
             Foreground="{StaticResource TextMain}"
             FontFamily="Microsoft YaHei UI, Microsoft YaHei, Segoe UI"
             Focusable="True" FocusVisualStyle="{x:Null}">

    <UserControl.Resources>

        <!-- ===== 深色滚动条 ===== -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#FF2A3038" CornerRadius="4" Margin="1,2,1,2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 普通按钮 ===== -->
        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Background" Value="#FF1B1F26"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="BorderBrush" Value="#FF2A3038"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#FF465263"/>
                                <Setter TargetName="bd" Property="Background" Value="#FF232A33"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.32"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 控制条大按钮 ===== -->
        <Style x:Key="BigBtn" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="#22FFFFFF" BorderThickness="1"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#55FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.84"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 键帽 ===== -->
        <Style x:Key="Kbd" TargetType="Border">
            <Setter Property="Background" Value="#1FFFFFFF"/>
            <Setter Property="BorderBrush" Value="#2EFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="5,1"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="KbdText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#D9FFFFFF"/>
        </Style>

        <!-- ===== 开关 ===== -->
        <Style x:Key="Toggle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FF8B93A1"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="box" Width="14" Height="14" CornerRadius="4"
                                    Background="#FF1B1F26" BorderBrush="#FF3A424E" BorderThickness="1"
                                    VerticalAlignment="Center" Margin="0,0,6,0">
                                <TextBlock x:Name="tick" Text="✓" FontSize="9" Foreground="#FF0E1013"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="Background" Value="#FFC9D2DE"/>
                                <Setter TargetName="box" Property="BorderBrush" Value="#FFC9D2DE"/>
                                <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="#FFE6E9EF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="#FF6B7684"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 右侧列表里的小动作按钮（▸ / ✎） ===== -->
        <Style x:Key="MiniBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FF9AA3B0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="5,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF232A33"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#FF3A424E"/>
                                <Setter Property="Foreground" Value="#FFE6E9EF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 删除按钮（✕）：平时灰，悬停变红，确认态红底 ===== -->
        <Style x:Key="MiniBtnDanger" TargetType="Button" BasedOn="{StaticResource MiniBtn}">
            <Setter Property="Foreground" Value="#FF8E8280"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 顶栏：设备 / 开关 -->
            <RowDefinition Height="*"/>      <!-- 左文案 / 中提词 / 右已录 -->
            <RowDefinition Height="Auto"/>   <!-- 底部录音台 -->
        </Grid.RowDefinitions>

        <!-- ============================================================
             顶栏（细，一行）
             ============================================================ -->
        <Border Grid.Row="0" Height="46" Background="#FF11141A"
                BorderBrush="#FF22272F" BorderThickness="0,0,0,1" Padding="16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="录音台" FontSize="13" FontWeight="Bold" Foreground="#FFE6E9EF"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Border Width="1" Height="13" Background="#FF2A3038" Margin="0,0,12,0"/>
                    <TextBlock Text="麦克风" FontSize="11.5" Foreground="#FF78828F"
                               VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <ComboBox x:Name="CmbDevice" Width="210" Height="26" FontSize="12"
                              VerticalAlignment="Center" SelectionChanged="CmbDevice_SelectionChanged"/>
                    <Button x:Name="BtnRefreshDevices" Content="刷新" Style="{StaticResource GhostBtn}"
                            Margin="7,0,0,0" Click="BtnRefreshDevices_Click"
                            ToolTip="先连上手机、再点刷新（WO Mic 必须客户端在跑）"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="ChkAutoPlay" Content="录完自动试听" Style="{StaticResource Toggle}"
                              Margin="0,0,14,0" Checked="ChkAutoPlay_Changed" Unchecked="ChkAutoPlay_Changed"/>
                    <CheckBox x:Name="ChkAutoGuess" Content="没选就猜范围" Style="{StaticResource Toggle}"
                              Margin="0,0,14,0" Checked="ChkAutoGuess_Changed" Unchecked="ChkAutoGuess_Changed"/>
                    <Button x:Name="BtnReloadScript" Content="重读稿子" Style="{StaticResource GhostBtn}"
                            Click="BtnReloadScript_Click"
                            ToolTip="稿子改过之后点一下（不会动录音）"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================
             主体：左文案 / 中提词 / 右已录
             ============================================================ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="352"/>
                <ColumnDefinition Width="*" MinWidth="360"/>
                <ColumnDefinition Width="248"/>
            </Grid.ColumnDefinitions>

            <!-- ===== 左：文案选择区 ===== -->
            <Border Grid.Column="0" Background="#FF12151A"
                    BorderBrush="#FF22272F" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="13,9,10,8" BorderBrush="#FF1E232B"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="文案" FontSize="12.5" FontWeight="Bold"
                                           Foreground="#FFE6E9EF" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtDocStat" Text="0 / 0 句" FontSize="11"
                                           Foreground="#FF78828F" Margin="9,0,0,0" VerticalAlignment="Center"
                                           FontFamily="Cascadia Mono, Consolas"/>
                            </StackPanel>
                            <Button x:Name="BtnClearSel" Content="清除选择" HorizontalAlignment="Right"
                                    Style="{StaticResource GhostBtn}" FontSize="11"
                                    Click="BtnClearSel_Click"/>
                        </Grid>
                    </Border>

                    <ScrollViewer x:Name="ScriptScroll" Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="10,9,6,18">
                        <StackPanel x:Name="ScriptPanel"/>
                    </ScrollViewer>

                    <Border Grid.Row="2" Padding="13,6" Background="#FF0F1216"
                            BorderBrush="#FF1E232B" BorderThickness="0,1,0,0">
                        <TextBlock FontSize="10.5" Foreground="#FF6E7783" TextWrapping="Wrap" LineHeight="16">
                            点句子＝从这儿录（点绿块里任意一句＝整块选中，直接重录）·
                            <Run Foreground="#FFC9D2DE">Shift+点</Run> 延长/缩短
                        </TextBlock>
                    </Border>
                </Grid>
            </Border>

            <!-- ===== 中：提词区 ===== -->
            <Grid Grid.Column="1" Margin="34,18,34,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <TextBlock x:Name="TxtSegNow" Text="下一段" FontSize="12" FontWeight="Bold"
                               Foreground="#FFE6E9EF" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtSegMeta" Text="" FontSize="11.5" Foreground="#FF78828F"
                               Margin="10,0,0,0" VerticalAlignment="Center"
                               FontFamily="Cascadia Mono, Consolas"/>
                    <Border x:Name="BadgeHost" CornerRadius="5" Padding="7,2" Margin="10,0,0,0"
                            Background="#FF232A33" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtBadge" Text="待录" FontSize="11"
                                   Foreground="#FF8B93A1"/>
                    </Border>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel VerticalAlignment="Center" Margin="0,10,0,0">
                        <TextBlock x:Name="TxtPrev" Text="" FontSize="14.5" Foreground="#FF59616C"
                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="54"
                                   Margin="3,0,0,12"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="CurBar" Grid.Column="0" Width="3" CornerRadius="2"
                                    Background="#FF39414C" Margin="0,8,15,8"/>
                            <TextBlock x:Name="TxtCur" Grid.Column="1" Text=""
                                       FontSize="30" LineHeight="50" TextWrapping="Wrap"
                                       Foreground="#FFF4F2EC"/>
                        </Grid>
                        <TextBlock x:Name="TxtNext" Text="" FontSize="14.5" Foreground="#FF59616C"
                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="54"
                                   Margin="3,0,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ===== 右：已录列表 ===== -->
            <Border Grid.Column="2" Background="#FF12151A"
                    BorderBrush="#FF22272F" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="11,9,9,8" BorderBrush="#FF1E232B"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="已录" FontSize="12.5" FontWeight="Bold"
                                           Foreground="#FFE6E9EF" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtTakeCount" Text="0 条" FontSize="11"
                                           Foreground="#FF78828F" Margin="8,0,0,0" VerticalAlignment="Center"
                                           FontFamily="Cascadia Mono, Consolas"/>
                            </StackPanel>
                            <Button x:Name="BtnUndo" Content="↶ 撤销" HorizontalAlignment="Right"
                                    Style="{StaticResource GhostBtn}" FontSize="11"
                                    Click="BtnUndo_Click" ToolTip="回退最近一次确认（Ctrl+Z）"/>
                        </Grid>
                    </Border>

                    <ScrollViewer x:Name="TakeScroll" Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="9,8,7,14">
                        <StackPanel x:Name="TakeList"/>
                    </ScrollViewer>

                    <Border Grid.Row="2" Padding="11,6" Background="#FF0F1216"
                            BorderBrush="#FF1E232B" BorderThickness="0,1,0,0">
                        <TextBlock FontSize="10.5" Foreground="#FF6E7783" TextWrapping="Wrap" LineHeight="16">
                            点一条＝选中它（左栏同步高亮）· ▸ 试听 · ✎ 改绑 · ✕ 删除（删错 Ctrl+Z 找回）
                        </TextBlock>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ============================================================
             底部：录音台
             ============================================================ -->
        <Border Grid.Row="2" Background="#FF0F1216" BorderBrush="#FF1E232B" BorderThickness="0,1,0,0"
                Padding="18,8,18,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 体检结论 + 电平 -->
                <Grid Grid.Row="0" Margin="2,0,2,5">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="VerdictTagHost" CornerRadius="5" Padding="7,2" Visibility="Collapsed"
                                Margin="0,0,8,0" Background="#FF232A33">
                            <TextBlock x:Name="TxtVerdictTag" Text="" FontSize="11" FontWeight="Bold"
                                       Foreground="#FF8B93A1"/>
                        </Border>
                        <TextBlock x:Name="TxtVerdict" Text="" FontSize="11.5" Foreground="#FF78828F"
                                   MaxWidth="620" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="电平" FontSize="11" Foreground="#FF6E7783" VerticalAlignment="Center"/>
                        <Border x:Name="MeterHost" Width="90" Height="6" CornerRadius="3"
                                Background="#FF232A33" Margin="7,0,7,0" VerticalAlignment="Center">
                            <Border x:Name="MeterFill" Width="0" HorizontalAlignment="Left" CornerRadius="3"
                                    Background="#FF22C55E"/>
                        </Border>
                        <TextBlock x:Name="TxtDb" Text="-96" FontFamily="Cascadia Mono, Consolas"
                                   FontSize="11" Foreground="#FF78828F" VerticalAlignment="Center"
                                   Width="32" TextAlignment="Right"/>
                    </StackPanel>
                </Grid>

                <!-- 波形 -->
                <Grid Grid.Row="1" Margin="2,0,2,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="2,0,2,2">
                        <TextBlock x:Name="WaveLabel" Text="还没有录" FontSize="10.5"
                                   Foreground="#FF6E7783"/>
                        <TextBlock x:Name="WaveTime" Text="00:00.0" FontSize="10.5" HorizontalAlignment="Right"
                                   Foreground="#FF6E7783" FontFamily="Cascadia Mono, Consolas"/>
                    </Grid>
                    <rd:TakeWaveBar x:Name="Wave" Grid.Row="1" Height="52"/>
                </Grid>

                <!-- 控制条 -->
                <Grid Grid.Row="2" Margin="0,4,0,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtTime" Text="00:00.0" FontFamily="Cascadia Mono, Consolas"
                                   FontSize="15" Foreground="#FFE6E9EF" Width="86"
                                   VerticalAlignment="Center"/>
                        <Ellipse x:Name="RecDot" Width="8" Height="8" Fill="#FF39414C" Margin="0,0,12,0"
                                 VerticalAlignment="Center"/>

                        <Button x:Name="BtnMain" Style="{StaticResource BigBtn}" Click="BtnMain_Click"
                                Background="#FFC7443A" Margin="0,0,7,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="TxtMainDot" Text="●" FontSize="10" VerticalAlignment="Center"
                                           Margin="0,0,7,0"/>
                                <TextBlock x:Name="TxtMainLabel" Text="开始录音" FontSize="12.5" FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                                <Border Style="{StaticResource Kbd}">
                                    <TextBlock Text="空格" Style="{StaticResource KbdText}"/>
                                </Border>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnPlay" Style="{StaticResource BigBtn}" Click="BtnPlay_Click"
                                Background="#FF1B1F26" Foreground="#FFE6E9EF" Margin="0,0,7,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▶" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0"
                                           Foreground="#FFC9D2DE"/>
                                <TextBlock Text="试听" FontSize="12" VerticalAlignment="Center"/>
                                <Border Style="{StaticResource Kbd}" Background="#0FFFFFFF" BorderBrush="#1FFFFFFF">
                                    <TextBlock Text="P" Style="{StaticResource KbdText}" Foreground="#99FFFFFF"/>
                                </Border>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnRedo" Style="{StaticResource BigBtn}" Click="BtnRedo_Click"
                                Background="#FF1B1F26" Foreground="#FFE6E9EF" Margin="0,0,7,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="↻" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"
                                           Foreground="#FFC9D2DE"/>
                                <TextBlock Text="重录" FontSize="12" VerticalAlignment="Center"/>
                                <Border Style="{StaticResource Kbd}" Background="#0FFFFFFF" BorderBrush="#1FFFFFFF">
                                    <TextBlock Text="R" Style="{StaticResource KbdText}" Foreground="#99FFFFFF"/>
                                </Border>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnOk" Style="{StaticResource BigBtn}" Click="BtnOk_Click"
                                Background="#FF2C6E49" Margin="0,0,7,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✓" FontSize="11" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock x:Name="TxtOkLabel" Text="就绑这段" FontSize="12.5" FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                                <Border Style="{StaticResource Kbd}">
                                    <TextBlock Text="回车" Style="{StaticResource KbdText}"/>
                                </Border>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnDiscard" Style="{StaticResource BigBtn}" Click="BtnDiscard_Click"
                                Background="#FF1B1F26" Foreground="#FFE6E9EF">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✕" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0"
                                           Foreground="#FFC9D2DE"/>
                                <TextBlock Text="不要这条" FontSize="12" VerticalAlignment="Center"/>
                                <Border Style="{StaticResource Kbd}" Background="#0FFFFFFF" BorderBrush="#1FFFFFFF">
                                    <TextBlock Text="Esc" Style="{StaticResource KbdText}" Foreground="#99FFFFFF"/>
                                </Border>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ===== 空状态：这个项目还没有稿子 ===== -->
        <Grid x:Name="EmptyHost" Grid.RowSpan="3" Background="#FF0E1013" Visibility="Collapsed">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520"
                    Background="#FF161A20" BorderBrush="#FF2A3038" BorderThickness="1"
                    CornerRadius="12" Padding="30,26">
                <StackPanel>
                    <TextBlock Text="这个项目还没有稿子" FontSize="17" FontWeight="Bold"
                               Foreground="#FFE6E9EF" Margin="0,0,0,10"/>
                    <TextBlock x:Name="TxtEmptyWhy" TextWrapping="Wrap" LineHeight="23" FontSize="12.5"
                               Foreground="#FF8B93A1"
                               Text="录音台是照着稿子念的。先去写作台写（或者把已有的稿子贴进 script.md 保存），再回来这里。"/>
                    <TextBlock Text="稿子路径：&lt;项目&gt;\script.md" FontSize="11" Margin="0,14,0,0"
                               Foreground="#FF5F6772" FontFamily="Cascadia Mono, Consolas"/>
                    <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                        <Button Content="去写作台" Style="{StaticResource BigBtn}" Height="34"
                                Background="#FF2563EB" Click="BtnGoScript_Click"/>
                        <Button Content="重新读一次" Style="{StaticResource GhostBtn}" Margin="10,0,0,0"
                                Padding="14,6" Click="BtnReloadScript_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
