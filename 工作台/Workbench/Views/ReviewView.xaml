<!-- ============================================================
     ReviewView.xaml - 复盘 · 作品页（第二层）★ V1.14.0 建，V1.15.0 定为第二层
     ============================================================
     【★ V1.15.0 起：它是"点进某支片"才看到的那一页】
       复盘现在是两层（一层套一层，跟抖音创作者中心一样）：
         第一层 账号页  = AccountReviewView（更新节奏 + 账号数据 + 作品列表）
         第二层 作品页  = **本页**（这一支片的完整数据）
       在账号页的作品列表里点「打开 ›」就钻进这里；「← 返回账号」那条返回栏
       由容器 ReviewHostView 画 —— 所以这一页**不需要知道自己被谁装着**，
       它只负责"把某一支片的数据铺出来"。

     【它是怎么知道看哪一支片的】
       平时靠顶上那个「看哪个项目」下拉；从账号页钻进来时由外面调 ShowProject()
       直接指定（否则会出现"点了 A 进去却是 B"）。

     【数据落点】<项目>\review\review.json（本地权威，跟归档解耦）
     ============================================================ -->
<UserControl x:Class="LiteCut.Workbench.Views.ReviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgDeep}"
             Foreground="{StaticResource TextMain}">

    <DockPanel>

        <!-- ============ 顶部标题 + 项目选择器 ============ -->
        <Border DockPanel.Dock="Top" Padding="20,16,20,14"
                Background="#FF12151A" BorderBrush="{StaticResource Border}"
                BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="作品复盘" FontSize="17" FontWeight="SemiBold" Foreground="White"/>

                <!-- ★ 一级页面没有"当前项目"，靠这个选择器挑 -->
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                            VerticalAlignment="Center">
                    <TextBlock Text="看哪个项目：" FontSize="12"
                               Foreground="{StaticResource TextDim}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="PickProject" Width="300"
                              FontSize="12.5" VerticalAlignment="Center"
                              SelectionChanged="PickProject_SelectionChanged"/>
                </StackPanel>

                <TextBlock x:Name="TxtSub" FontSize="11.5" Margin="0,8,0,0"
                           Foreground="{StaticResource TextFaint}" TextWrapping="Wrap"
                           Text="数据随时能填，跟归不归档没关系。一条 = 一个平台在某一天的一组数。"/>
            </StackPanel>
        </Border>

        <!-- ============ 归档说明条（只有已归档项目可见） ============ -->
        <Border x:Name="ArchiveBar" DockPanel.Dock="Top" Visibility="Collapsed"
                Margin="20,14,20,0" Padding="14,12" CornerRadius="8"
                Background="#FF182636" BorderBrush="#FF2F4A6B" BorderThickness="1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button x:Name="BtnRestore" Content="取回工程" Click="BtnRestore_Click"
                            Style="{StaticResource BtnPrimary}"
                            FontSize="12" Padding="12,5" Margin="0,0,8,0"/>
                    <Button Content="打开归档文件夹" Click="BtnOpenArchive_Click"
                            Style="{StaticResource Btn}" FontSize="12" Padding="12,5"/>
                </StackPanel>

                <TextBlock x:Name="TxtArchiveInfo" Foreground="#FFBBD4F0"
                           FontSize="12.5" TextWrapping="Wrap"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,14,20,22">
            <StackPanel>

                <!-- ============ ① 录入 ============ -->
                <Border Background="{StaticResource BgCard}"
                        BorderBrush="{StaticResource Border}" BorderThickness="1"
                        CornerRadius="10" Padding="16,15,16,15">
                    <StackPanel>
                        <TextBlock Text="① 录一次数据" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock Text="一屏填完。填好点「保存为新快照」；想改老数据，先在下面点中那一条。"
                                   FontSize="11.5" Margin="0,4,0,12"
                                   Foreground="{StaticResource TextFaint}"/>

                        <!-- 元信息：平台 / 发布日 / 统计日 / 天数 -->
                        <UniformGrid Columns="4" Margin="0,0,0,10">
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="平台" FontSize="11" Foreground="{StaticResource TextDim}" Margin="0,0,0,4"/>
                                <TextBox x:Name="InPlatform" Style="{StaticResource Tbx}" Text="抖音"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="发布日 (年-月-日)" FontSize="11" Foreground="{StaticResource TextDim}" Margin="0,0,0,4"/>
                                <TextBox x:Name="InPublish" Style="{StaticResource Tbx}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="统计日 (年-月-日)" FontSize="11" Foreground="{StaticResource TextDim}" Margin="0,0,0,4"/>
                                <TextBox x:Name="InStats" Style="{StaticResource Tbx}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="距发布天数（自动算，可改）" FontSize="11" Foreground="{StaticResource TextDim}" Margin="0,0,0,4"/>
                                <TextBox x:Name="InDays" Style="{StaticResource Tbx}"/>
                            </StackPanel>
                        </UniformGrid>

                        <!-- 八个基本数 -->
                        <UniformGrid Columns="4" Margin="0,0,0,10">
                            <StackPanel Margin="0,0,10,8">
                                <TextBlock Text="播放" FontSize="11" Foreground="{StaticResource TextDim}" Margin="0,0,0,4"/>
                                <TextBox x:Name="InPlay" Style="{StaticResource Tbx}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,10,8">
                                <TextBlock Text="完播率 (%)" FontSize="11" Foreground="{StaticResource TextDim}" Margin="0,0,0,4"/>
                                <TextBox x:Name="InFinish" Style="{StaticResource Tbx}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,10,8">
                                <TextBlock Text="点赞" FontSize="11" Foreground="{StaticResource TextDim}" Margin="0,0,0,4"/>
                                <TextBox x:Name="InLike" Style="{StaticResource Tbx}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="涨粉" FontSize="11" Foreground="{StaticResource TextDim}" Margin="0,0,0,4"/>
                                <TextBox x:Name="InFollow" Style="{StaticResource Tbx}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="收藏" FontSize="11" Foreground="{StaticResource TextDim}" Margin="0,0,0,4"/>
                                <TextBox x:Name="InFavorite" Style="{StaticResource Tbx}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="评论" FontSize="11" Foreground="{StaticResource TextDim}" Margin="0,0,0,4"/>
                                <TextBox x:Name="InComment" Style="{StaticResource Tbx}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="转发" FontSize="11" Foreground="{StaticResource TextDim}" Margin="0,0,0,4"/>
                                <TextBox x:Name="InShare" Style="{StaticResource Tbx}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="主页访问" FontSize="11" Foreground="{StaticResource TextDim}" Margin="0,0,0,4"/>
                                <TextBox x:Name="InHome" Style="{StaticResource Tbx}"/>
                            </StackPanel>
                        </UniformGrid>

                        <!-- 三段式结论 -->
                        <TextBlock Text="三段式结论（可以只填一段，也可以都不填）"
                                   FontSize="11.5" Margin="0,6,0,8" Foreground="{StaticResource TextFaint}"/>

                        <TextBlock Text="这条讲对了什么" FontSize="11" Foreground="{StaticResource TextDim}" Margin="0,0,0,4"/>
                        <TextBox x:Name="InGood" Style="{StaticResource Tbx}" Height="54"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" Margin="0,0,0,10"/>

                        <TextBlock Text="哪里没接住" FontSize="11" Foreground="{StaticResource TextDim}" Margin="0,0,0,4"/>
                        <TextBox x:Name="InMissed" Style="{StaticResource Tbx}" Height="54"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" Margin="0,0,0,10"/>

                        <TextBlock Text="下次改什么" FontSize="11" Foreground="{StaticResource TextDim}" Margin="0,0,0,4"/>
                        <TextBox x:Name="InNext" Style="{StaticResource Tbx}" Height="54"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" Margin="0,0,0,12"/>

                        <!-- 按钮 -->
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BtnSave" Content="保存为新快照" Click="BtnSave_Click"
                                    Style="{StaticResource BtnPrimary}" FontSize="12.5" Padding="16,6" Margin="0,0,8,0"/>
                            <Button Content="新建一条（清空表单）" Click="BtnNew_Click"
                                    Style="{StaticResource Btn}" FontSize="12.5" Padding="14,6" Margin="0,0,8,0"/>
                            <Button Content="生成复盘报告.md" Click="BtnReport_Click"
                                    Style="{StaticResource Btn}" FontSize="12.5" Padding="14,6"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ============ ② 已有快照 ============ -->
                <Border Background="{StaticResource BgCard}" Margin="0,14,0,0"
                        BorderBrush="{StaticResource Border}" BorderThickness="1"
                        CornerRadius="10" Padding="16,15,16,15">
                    <StackPanel>
                        <TextBlock Text="② 已有的快照" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock Text="点中一条 = 把它载进上面的表单改；改完再点「保存为新快照」就是那一条更新。"
                                   FontSize="11.5" Margin="0,4,0,12"
                                   Foreground="{StaticResource TextFaint}"/>

                        <ListView x:Name="ListRecords" Height="230"
                                  Background="{StaticResource BgInput}"
                                  BorderBrush="{StaticResource Border}" BorderThickness="1"
                                  SelectionChanged="ListRecords_SelectionChanged">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="平台"  Width="90"  DisplayMemberBinding="{Binding Platform}"/>
                                    <GridViewColumn Header="发布日" Width="96"  DisplayMemberBinding="{Binding PublishDate}"/>
                                    <GridViewColumn Header="统计日" Width="96"  DisplayMemberBinding="{Binding StatsDate}"/>
                                    <GridViewColumn Header="天数"  Width="52"  DisplayMemberBinding="{Binding DaysAfter}"/>
                                    <GridViewColumn Header="播放"  Width="86"  DisplayMemberBinding="{Binding Play}"/>
                                    <GridViewColumn Header="完播率" Width="66"  DisplayMemberBinding="{Binding FinishRate}"/>
                                    <GridViewColumn Header="点赞"  Width="70"  DisplayMemberBinding="{Binding Like}"/>
                                    <GridViewColumn Header="涨粉"  Width="70"  DisplayMemberBinding="{Binding Follow}"/>
                                    <GridViewColumn Header="收藏"  Width="70"  DisplayMemberBinding="{Binding Favorite}"/>
                                    <GridViewColumn Header="评论"  Width="70"  DisplayMemberBinding="{Binding Comment}"/>
                                    <GridViewColumn Header="转发"  Width="70"  DisplayMemberBinding="{Binding Share}"/>
                                    <GridViewColumn Header="主页访问" Width="80" DisplayMemberBinding="{Binding HomeVisit}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="删除选中的这一条" Click="BtnDelete_Click"
                                    Style="{StaticResource BtnDanger}" FontSize="12" Padding="12,5"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="数据存在项目自己的 review\review.json 里（本地）。归档之后它照样在本地 —— 硬盘不插着也能看、能填。"
                           FontSize="11" Margin="2,12,0,0" TextWrapping="Wrap"
                           Foreground="{StaticResource TextFaint}"/>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
