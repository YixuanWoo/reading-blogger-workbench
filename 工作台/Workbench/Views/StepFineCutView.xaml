<UserControl x:Class="LiteCut.Workbench.Views.StepFineCutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LiteCut.Workbench.Views"
             FontFamily="Microsoft YaHei"
             Background="{DynamicResource BgDeep}">

    <!-- ============================================================
         第②步：精剪 —— 编辑器直接长在工作台里
         ============================================================
         【和旧版的区别】
         旧版：本页只是个"交接卡"，点按钮开独立编辑器窗口，关窗接回。
         新版：编辑器（EditorView，原轻剪主窗口的壳）直接铺满本页，
               不再有第二个窗口。切换到其它步骤时自动把结果接回工作台。

         【数据流（不变的部分）】
           进：State.KeepRanges()（录音台铺好的母带区间；精剪接管后就是精剪块）
               → EditorView.LoadPreCutProject() 铺成时间轴块
           出：EditorView.GetTimelineKeeps()
               → 和上一版决策比对，有差异才覆盖 State.FineCutKeeps
         ============================================================ -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============ 顶部信息条 ============ -->
        <Border Grid.Row="0" Padding="16,9,16,9"
                Background="{DynamicResource BgShell}"
                BorderBrush="{DynamicResource Border}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 左：标题 + 状态摘要 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="精剪" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMain}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtPlanSummary" Text=""
                               FontSize="12" Foreground="{DynamicResource TextDim}"
                               VerticalAlignment="Center" Margin="18,0,0,0"/>
                    <TextBlock x:Name="TxtFineCutStatus" Text=""
                               FontSize="12" Foreground="{DynamicResource Ok}"
                               VerticalAlignment="Center" Margin="14,0,0,0"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="TxtDownstream" Text=""
                               FontSize="12" Foreground="{DynamicResource TextDim}"
                               VerticalAlignment="Center" Margin="18,0,0,0"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <!-- 右：操作按钮 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnApply" Content="应用到下游"
                            Style="{StaticResource BtnPrimary}" FontSize="12.5"
                            Padding="14,6" Click="BtnApply_Click"/>
                    <Button x:Name="BtnRevert" Content="还原为铺排"
                            Style="{StaticResource Btn}" FontSize="12.5"
                            Padding="12,6" Margin="8,0,0,0" Click="BtnRevert_Click"/>
                    <Button x:Name="BtnFullscreen" Content="⛶ 全屏"
                            Style="{StaticResource Btn}" FontSize="12.5"
                            Padding="12,6" Margin="8,0,0,0" Click="BtnFullscreen_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ 录音台更新提示条（默认隐藏） ============ -->
        <!--
             【为什么要这条】
               以前粗剪一重跑，本页会**直接拿新粗剪重铺时间轴** ——
               你手工挪过的块、调过的音量、加的淡化，当场全没。
               对用户来说这是"调了一下粗剪，精剪成果被吃掉了"，非常冤。

               现在的规矩：粗剪更新**不碰**你的时间轴，只是在这里提示一句。
               要不要用新粗剪重铺，你自己点。
        -->
        <Border x:Name="CoarseUpdateBar" Grid.Row="1" Visibility="Collapsed"
                Padding="16,8,16,8" Margin="0" Background="{DynamicResource WarnBannerBg}"
                BorderBrush="{DynamicResource Warn}" BorderThickness="0,0,0,1">
            <Grid>
                <TextBlock x:Name="TxtCoarseUpdate" FontSize="12"
                           Foreground="{DynamicResource Warn}" VerticalAlignment="Center"
                           TextWrapping="Wrap" Margin="0,0,150,0"/>
                <Button Content="用新母带重铺时间轴" HorizontalAlignment="Right"
                        Style="{StaticResource Btn}" FontSize="12" Padding="12,4"
                        Click="BtnReloadCoarse_Click"
                        ToolTip="当前时间轴会被录音台新铺的母带替换（这一步不可撤销）"/>
            </Grid>
        </Border>

        <!-- ============ 编辑器（铺满剩余空间，全屏时吃满整窗） ============ -->
        <Grid x:Name="EditorHost" Grid.Row="2"/>

        <!-- ============ 还没有母带时的占位提示 ============ -->
        <Border x:Name="Placeholder" Grid.Row="2" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420">
                <TextBlock Text="还没有可精剪的内容" FontSize="18" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextMain}" HorizontalAlignment="Center"/>
                <TextBlock Margin="0,10,0,0" FontSize="13" Foreground="{DynamicResource TextDim}"
                           TextWrapping="Wrap" TextAlignment="Center"
                           Text="去录音台把稿子念完，点右上角「应用到下游」——母带会拼成一条，这里就按「一条录音一块」铺好，你只管拖边界调气口。"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
