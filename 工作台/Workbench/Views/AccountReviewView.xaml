<!-- ============================================================
     AccountReviewView.xaml - ★ V1.15.0 复盘 · 账号页（第一层）
     ============================================================
     【这一页回答什么】
       "我这个号，最近在稳定出片吗？数据在什么水平？"
       它不是某个项目的页 —— 它是**所有项目加起来**的那个视角。

     【三层结构，从上到下（跟抖音创作者中心一个思路）】
       ① 主图区（ContentControl，**可换内容**）—— 现在装的是「更新节奏」热力图
       ② 账号数据（手填的 4 个数）—— 次要，背景板
       ③ 作品列表（一行一支片，数字自动汇总）—— 点一行钻进作品页

     【★ 为什么 ① 用 ContentControl 而不是直接写死】
       主图那个位置是"最贵"的，阶段一变就要换内容
       （0~10 支看节奏 → 10~30 支看"哪类内容行" → 30 支以上看涨粉曲线）。
       换成另一个控件只要改 AccountReviewView.xaml.cs 里那一行赋值，
       这一页的布局一个字都不用动。

     【★ 布局就是"几个模块上下摞"】
       三块都是独立的 Border/控件，调整位置和顺序 = 剪切粘贴这几段；
       改大小 = 改它们的 Margin/Height。模块内部不认识彼此。
     ============================================================ -->
<UserControl x:Class="LiteCut.Workbench.Views.AccountReviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BgDeep}"
             Foreground="{DynamicResource TextMain}">

    <DockPanel>

        <!-- ============ 顶栏：标题 + 平台筛选 ============ -->
        <Border DockPanel.Dock="Top" Padding="20,16,20,14"
                Background="{DynamicResource BgShell}" BorderBrush="{DynamicResource Border}"
                BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="平台" FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextDim}" Margin="0,0,7,0"/>
                    <ComboBox x:Name="PickPlatform" Width="132" FontSize="12.5"
                              VerticalAlignment="Center"
                              SelectionChanged="PickPlatform_SelectionChanged"/>
                    <Button x:Name="BtnRefresh" Content="重新汇总" Click="BtnRefresh_Click"
                            Style="{StaticResource Btn}" FontSize="12"
                            Padding="12,5" Margin="10,0,0,0"/>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="复盘" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextMain}"/>
                    <TextBlock x:Name="TxtSub" FontSize="11.5" Margin="0,4,0,0"
                               Foreground="{DynamicResource TextFaint}" TextWrapping="Wrap"
                               Text="这一页看的是整个号：更新节奏 + 账号数据 + 每一支片的表现。"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,14,20,22">
            <StackPanel>

                <!-- ============================================================
                     ① 主图区（可换内容）
                     ============================================================ -->
                <ContentControl x:Name="MainChartHost"/>

                <!-- ============================================================
                     ② 账号数据 —— 手填的那 4 个数
                     ============================================================ -->
                <Border Background="{DynamicResource BgCard}" Margin="0,14,0,0"
                        BorderBrush="{DynamicResource Border}" BorderThickness="1"
                        CornerRadius="10" Padding="16,14,16,14">
                    <StackPanel>

                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <TextBlock Text="这个号是" FontSize="11.5" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextDim}" Margin="0,0,6,0"/>
                                <ComboBox x:Name="PickSavePlatform" Width="104" FontSize="12"
                                          VerticalAlignment="Center"/>
                                <TextBlock Text="统计日" FontSize="11.5" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextDim}" Margin="12,0,6,0"/>
                                <TextBox x:Name="InStatsDate" Width="112"
                                         Style="{StaticResource Tbx}" FontSize="12"
                                         VerticalAlignment="Center"/>
                                <Button x:Name="BtnSaveAccount" Content="保存这组数"
                                        Click="BtnSaveAccount_Click"
                                        Style="{StaticResource BtnPrimary}" FontSize="12"
                                        Padding="14,5" Margin="10,0,0,0"/>
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Text="账号数据（手填）" FontSize="14"
                                           FontWeight="SemiBold" Foreground="{DynamicResource TextMain}"/>
                                <TextBlock x:Name="TxtAccountSub" FontSize="11.5" Margin="0,4,0,0"
                                           Foreground="{DynamicResource TextFaint}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </DockPanel>

                        <!-- 四个数：卡在代码里建（NumberField 控件），顺序固定 -->
                        <UniformGrid x:Name="StatGrid" Columns="4" Margin="0,12,0,0"/>

                        <TextBlock FontSize="11" Margin="0,11,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFaint}"
                                   Text="※ 上面这几格是你手填的（从平台后台抄）；下面列表里的数字是本工作台各支片自动加出来的。两回事，别对着看。"/>
                    </StackPanel>
                </Border>

                <!-- ============================================================
                     ③ 作品列表 —— 一行一支片
                     ============================================================ -->
                <Border Background="{DynamicResource BgCard}" Margin="0,14,0,0"
                        BorderBrush="{DynamicResource Border}" BorderThickness="1"
                        CornerRadius="10" Padding="16,14,16,14">
                    <StackPanel>
                        <TextBlock Text="作品列表" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextMain}"/>
                        <TextBlock x:Name="TxtWorksSub" FontSize="11.5" Margin="0,4,0,12"
                                   Foreground="{DynamicResource TextFaint}" TextWrapping="Wrap"/>

                        <ListView x:Name="ListWorks" Height="330"
                                  Background="{DynamicResource BgInput}"
                                  BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                  MouseDoubleClick="ListWorks_MouseDoubleClick">
                            <!-- 行高 + 选中色：默认模板的行又矮又亮，深色底下读不清 -->
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="4,3,4,3"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource SelBg}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.View>
                                <GridView>
                                    <!-- 作品名 + 状态角标 -->
                                    <GridViewColumn Header="作品" Width="250">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <DockPanel LastChildFill="True">
                                                    <Border DockPanel.Dock="Right"
                                                            Background="{DynamicResource BgInput}" CornerRadius="4"
                                                            Padding="6,1,6,1" Margin="8,0,0,0"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding StatusText}" FontSize="10"
                                                                   Foreground="{DynamicResource TextDim}"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Name}" FontSize="12.5"
                                                               Foreground="{DynamicResource TextMain}"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center"/>
                                                </DockPanel>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <!-- 发布日：★ 可以直接在这一格改（热力图靠它点亮） -->
                                    <GridViewColumn Header="发布日（可直接改）" Width="158">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <DockPanel LastChildFill="True">
                                                    <Button DockPanel.Dock="Right" Content="记今天"
                                                            Click="BtnPublishedToday_Click"
                                                            AutomationProperties.AutomationId="{Binding TodayButtonId}"
                                                            Style="{StaticResource Btn}"
                                                            FontSize="10.5" Padding="6,1,6,1"
                                                            Margin="5,0,0,0"
                                                            ToolTip="记成今天发布"/>
                                                    <TextBox Text="{Binding PublishDate, Mode=OneWay}"
                                                             AutomationProperties.AutomationId="{Binding DateBoxId}"
                                                             LostFocus="InPublishDate_LostFocus"
                                                             Style="{StaticResource Tbx}"
                                                             FontSize="11.5" Padding="5,2,5,2"
                                                             ToolTip="年-月-日，例如 2026-10-02"/>
                                                </DockPanel>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Header="播放" Width="78" DisplayMemberBinding="{Binding PlayText}"/>
                                    <GridViewColumn Header="点赞" Width="72" DisplayMemberBinding="{Binding LikeText}"/>
                                    <GridViewColumn Header="涨粉" Width="72" DisplayMemberBinding="{Binding FollowText}"/>
                                    <GridViewColumn Header="平台" Width="150" DisplayMemberBinding="{Binding PlatformsText}"/>

                                    <GridViewColumn Header="" Width="86">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="打开 ›" Click="BtnOpenWork_Click"
                                                        AutomationProperties.AutomationId="{Binding OpenButtonId}"
                                                        Style="{StaticResource Btn}"
                                                        FontSize="11.5" Padding="8,2,8,2"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <TextBlock x:Name="TxtWorksFoot" FontSize="11" Margin="0,10,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFaint}"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
