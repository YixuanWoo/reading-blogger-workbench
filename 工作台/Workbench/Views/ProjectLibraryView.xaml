<!-- ============================================================
     ProjectLibraryView.xaml - 项目自己的素材库
     ============================================================
     素材库是"每个项目独立"的 —— 这一期用到的录音、参考素材都归这一期，
     不会和下期混在一起。文件实体放在 <项目>\media\ 里。
     ============================================================ -->
<UserControl x:Class="LiteCut.Workbench.Views.ProjectLibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgDeep}"
             Foreground="{StaticResource TextMain}">

    <DockPanel>

        <Border DockPanel.Dock="Top" Padding="20,16,20,14"
                Background="#FF12151A" BorderBrush="{StaticResource Border}"
                BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Content="打开文件夹" Click="BtnOpenFolder_Click"
                            Style="{StaticResource Btn}" FontSize="12.5" Padding="12,6"
                            Margin="0,0,8,0"/>
                    <Button Content="刷新" Click="BtnRefresh_Click"
                            Style="{StaticResource Btn}" FontSize="12.5" Padding="12,6"
                            Margin="0,0,8,0"/>
                    <Button Content="＋ 导入素材" Click="BtnImport_Click"
                            Style="{StaticResource BtnPrimary}" FontSize="12.5" Padding="14,6"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="素材库" FontSize="17" FontWeight="SemiBold" Foreground="White"/>
                    <TextBlock x:Name="TxtDir" FontSize="11.5" Margin="0,4,0,0"
                               Foreground="{StaticResource TextFaint}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="20,8,20,8"
                Background="#FF12151A" BorderBrush="{StaticResource Border}"
                BorderThickness="0,1,0,0">
            <TextBlock x:Name="TxtHint" FontSize="11.5"
                       Foreground="{StaticResource TextDim}"/>
        </Border>

        <Grid>
            <ListView x:Name="ListFiles" Background="Transparent" BorderThickness="0"
                      Foreground="{StaticResource TextMain}"
                      SelectionMode="Single" Margin="12,10,12,10"
                      MouseDoubleClick="ListFiles_MouseDoubleClick">
                <ListView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="设为粗剪源文件" Click="MenuSetSource_Click"/>
                        <MenuItem Header="在资源管理器中显示" Click="MenuReveal_Click"/>
                        <Separator/>
                        <MenuItem Header="从项目移除（挪进 _已移除）" Click="MenuRemove_Click"/>
                    </ContextMenu>
                </ListView.ContextMenu>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,4">
                            <TextBlock Text="{Binding Name}" FontSize="12.5"
                                       Foreground="{StaticResource TextMain}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Meta}" FontSize="11" FontFamily="Consolas"
                                       Margin="0,2,0,0"
                                       Foreground="{StaticResource TextDim}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock x:Name="TxtEmpty" Visibility="Collapsed"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextAlignment="Center" FontSize="13" LineHeight="24"
                       Foreground="{StaticResource TextFaint}"
                       Text="这个项目还没有素材。&#x0a;&#x0a;点右上角「＋ 导入素材」把这一期的录音放进来。"/>
        </Grid>
    </DockPanel>
</UserControl>
