<!-- ============================================================
     ProjectListView.xaml - 项目卡片墙（"进行中" / "已归档" 共用）
     ============================================================
     同一个页面类、靠构造参数区分看哪一档 —— 因为两者的卡片长得一模一样，
     只有"哪来的一批项目"和"归档按钮是归档还是恢复"不同。
     ============================================================ -->
<UserControl x:Class="LiteCut.Workbench.Views.ProjectListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgDeep}"
             Foreground="{StaticResource TextMain}">

    <DockPanel>

        <!-- ============ 顶部：标题 + 操作 ============ -->
        <Border DockPanel.Dock="Top" Padding="20,16,20,14"
                Background="#FF12151A" BorderBrush="{StaticResource Border}"
                BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Content="更改项目位置" Click="BtnChangeRoot_Click"
                            Style="{StaticResource Btn}" FontSize="12.5" Padding="12,6"
                            Margin="0,0,8,0"/>
                    <Button Content="＋ 新建项目" Click="BtnNew_Click"
                            Style="{StaticResource BtnPrimary}" FontSize="12.5" Padding="14,6"/>
                </StackPanel>

                <StackPanel>
                    <TextBlock x:Name="TxtTitle" Text="进行中" FontSize="17"
                               FontWeight="SemiBold" Foreground="White"/>
                    <TextBlock x:Name="TxtRoot" FontSize="11.5" Margin="0,4,0,0"
                               Foreground="{StaticResource TextFaint}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============ 空状态 ============ -->
        <TextBlock x:Name="TxtEmpty" Visibility="Collapsed"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextAlignment="Center" FontSize="13" LineHeight="24"
                   Foreground="{StaticResource TextFaint}"/>

        <!-- ============ 卡片墙 ============ -->
        <ScrollViewer x:Name="ScrollCards" VerticalScrollBarVisibility="Auto"
                      Padding="20,16,8,16">
            <ItemsControl x:Name="ListCards">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="272" Margin="0,0,12,12" Padding="14,13,14,13"
                                Background="{StaticResource BgCard}"
                                BorderBrush="{StaticResource Border}" BorderThickness="1"
                                CornerRadius="10"
                                MouseLeftButtonDown="Card_MouseLeftButtonDown">
                            <StackPanel>

                                <!-- 名字 + 状态角标 -->
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" x:Name="Badge"
                                            Background="#FF232830" CornerRadius="4"
                                            Padding="6,2,6,2" VerticalAlignment="Center"
                                            Margin="8,0,0,0">
                                        <TextBlock Text="{Binding StatusText}" FontSize="10"
                                                   Foreground="{StaticResource TextDim}"/>
                                    </Border>
                                    <TextBlock Text="{Binding Name}" FontSize="14.5"
                                               FontWeight="SemiBold" Foreground="White"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>
                                </DockPanel>

                                <!-- 备注 -->
                                <TextBlock Text="{Binding Note}" FontSize="11.5" Margin="0,7,0,0"
                                           Foreground="{StaticResource TextDim}"
                                           TextWrapping="Wrap" MaxHeight="32"
                                           Visibility="{Binding NoteVisibility}"/>

                                <!-- 进度 -->
                                <ProgressBar Height="4" Margin="0,12,0,6"
                                             Minimum="0" Maximum="100"
                                             Value="{Binding Progress, Mode=OneWay}"
                                             Foreground="{StaticResource Accent}"
                                             Background="#FF232830" BorderThickness="0"/>
                                <TextBlock Text="{Binding Meta}" FontSize="11"
                                           Foreground="{StaticResource TextFaint}"
                                           TextTrimming="CharacterEllipsis"/>

                                <!-- 板载操作 -->
                                <StackPanel Orientation="Horizontal" Margin="0,11,0,0">
                                    <Button Content="{Binding OpenButtonText}" Click="BtnOpen_Click"
                                            Style="{StaticResource BtnPrimary}"
                                            FontSize="12" Padding="14,4" Margin="0,0,6,0"/>
                                    <Button Content="{Binding ArchiveButtonText}"
                                            Click="BtnArchive_Click"
                                            Style="{StaticResource Btn}"
                                            FontSize="12" Padding="10,4" Margin="0,0,6,0"/>
                                    <Button Content="移除" Click="BtnRemove_Click"
                                            Style="{StaticResource BtnDanger}"
                                            FontSize="12" Padding="10,4"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
