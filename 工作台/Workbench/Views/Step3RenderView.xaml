<UserControl x:Class="LiteCut.Workbench.Views.Step3RenderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei">
    <!--
        第④步：渲染 —— 镜头审阅台（2026-09-30 改版）

        【为什么从「一张 219 行表格」改成三栏】
          用户原话："屏幕空荡荡全是些文字。我不知道每个镜头实际播放出来什么样。"
          表格能回答"有哪些镜头"，但回答不了"这一镜长什么样"和"要不要重做"。
          所以拆成三栏，每栏回答一个问题：
            左 = 有哪些镜头、哪个有问题（缩略图 + 状态灯，可切网格横扫）
            中 = 这一镜长什么样（真 MP4 播放 + 能直接改文案/构思/动效 + 写修改意见）
            右 = 要不要重做（本镜状态 + 让 Agent 改这一镜 + 版本对比）

        【★ 重渲按钮的本质 = 拉 Agent 来干活】
          不是"把同一个镜头再渲一遍" —— 那样毫无意义。
          是把【用户写的修改意见】+【这一镜原本的分镜设计】+【原本渲染前写好的 HTML 的路径】
          一起交给 Agent，让它在**原代码基础上改**，再只重渲这一镜。
          所以中栏那个「修改意见」输入框是这一步的核心控件，不是附属品。

        【XAML 里绝不写死初始值】
          IsChecked / Text 这类初始值会在控件树建到一半时触发事件，
          handler 访问到还没创建的控件 → 整个页面起不来（进程级崩溃）。
          初始值一律放构造函数里设，handler 开头用 UiReady 守卫。
    -->
    <UserControl.Resources>

        <!-- 筛选 / 视图切换用的胶囊按钮 -->
        <Style x:Key="Chip" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" CornerRadius="10" Padding="10,3" Background="Transparent"
                                BorderBrush="{DynamicResource Border}" BorderThickness="1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource TextFaint}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentSoftBg}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 左栏一个镜头项的外框（选中高亮） -->
        <Style x:Key="ShotItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" CornerRadius="5" Background="Transparent" Padding="5,3"
                                BorderBrush="Transparent" BorderThickness="2,0,0,0">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource WhiteSoftBg}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentSoftBg2}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 左栏：列表视图（缩略图 + 序号 + 时长 + 状态灯） -->
        <DataTemplate x:Key="TplRow">
            <Grid Height="34">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="54" Height="30" CornerRadius="4"
                        Background="{DynamicResource BgInput}" ClipToBounds="True" VerticalAlignment="Center">
                    <Grid>
                        <TextBlock Text="{Binding IndexText}" FontSize="10"
                                   Foreground="{DynamicResource TextFaint}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Image Source="{Binding Thumb}" Stretch="UniformToFill"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" Margin="8,0,6,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding HeadText}" FontSize="12"
                               Foreground="{DynamicResource TextMain}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding SubText}" FontSize="10.5"
                               Foreground="{DynamicResource TextFaint}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <Ellipse Grid.Column="2" Width="8" Height="8" VerticalAlignment="Center"
                         Fill="{Binding StatusBrush}"/>
            </Grid>
        </DataTemplate>

        <!-- 左栏：网格视图（一屏扫完，专门用来找"哪一格不对劲"） -->
        <DataTemplate x:Key="TplCell">
            <Border Width="104" Height="66" CornerRadius="4" Margin="0,0,6,6"
                    Background="{DynamicResource BgInput}" ClipToBounds="True">
                <Grid>
                    <Image Source="{Binding Thumb}" Stretch="UniformToFill"/>
                    <Border VerticalAlignment="Bottom" Background="{DynamicResource OverlayBg}" Padding="3,1">
                        <TextBlock Text="{Binding CellText}" FontSize="10" Foreground="{DynamicResource OnOverlay}"/>
                    </Border>
                    <Ellipse Width="7" Height="7" Margin="0,4,4,0" HorizontalAlignment="Right"
                             VerticalAlignment="Top" Fill="{Binding StatusBrush}"/>
                </Grid>
            </Border>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="TplListPanel">
            <VirtualizingStackPanel/>
        </ItemsPanelTemplate>

        <ItemsPanelTemplate x:Key="TplGridPanel">
            <WrapPanel Orientation="Horizontal"/>
        </ItemsPanelTemplate>

    </UserControl.Resources>

    <Grid Margin="16,14,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ==================== 顶部：工具条 ==================== -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="12,10,12,10" Margin="0,0,0,10">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="镜头审阅台" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMain}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtMeta" FontSize="11.5" Margin="10,0,0,0"
                               Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center"/>

                    <ToggleButton x:Name="ChipAll" Style="{StaticResource Chip}" Content="全部"
                                  Margin="18,0,0,0" Click="Chip_Click" Tag="all"/>
                    <ToggleButton x:Name="ChipEdit" Style="{StaticResource Chip}" Content="待重渲"
                                  Click="Chip_Click" Tag="edit"/>
                    <ToggleButton x:Name="ChipMissing" Style="{StaticResource Chip}" Content="未出片"
                                  Click="Chip_Click" Tag="missing"/>

                    <Button Content="切到网格" Style="{StaticResource Btn}" x:Name="BtnView"
                            Click="BtnView_Click" Padding="12,5,12,5" Margin="12,0,0,0"/>
                    <Button Content="扫描已渲染结果" Style="{StaticResource Btn}" x:Name="BtnScan"
                            Click="BtnScan_Click" Padding="12,5,12,5" Margin="6,0,0,0"
                            ToolTip="看看输出目录里已经渲好哪些镜头的 MP4"/>

                    <Button Content="生成渲染任务包" Style="{StaticResource Btn}" x:Name="BtnGenTasks"
                            Click="BtnGenTasks_Click" Padding="12,5,12,5" Margin="6,0,0,0"
                            ToolTip="为每个镜头生成一张 HTML 卡片 + 任务清单（交给 Agent 渲染前会自动生成一次）"/>
                    <Button Content="应用到下游" Style="{StaticResource Btn}" x:Name="BtnApplyDown"
                            Click="BtnApplyDown_Click" Padding="12,5,12,5" Margin="6,0,0,0"
                            ToolTip="把这一批渲染产物宣布为第⑤步组接的正式源，并逐块算出「画面时长 − 音频段时长」。只看不改：不会动任何渲染产物文件。"/>
                    <Button Content="交给 Agent 渲染（整批）" Style="{StaticResource BtnPrimary}"
                            Click="BtnRenderAgent_Click" x:Name="BtnRenderAgent"
                            Padding="14,6,14,6" Margin="6,0,0,0"
                            ToolTip="整批渲染所有还缺的镜头：搜图下载 + HyperFrames 逐镜出片。单镜不满意请用右栏「让 Agent 改这一镜」"/>
                    <Button Content="取消" Style="{StaticResource Btn}" Click="BtnCancelR_Click"
                            x:Name="BtnCancelR" Margin="6,0,0,0" Padding="12,6,12,6"/>

                    <TextBlock x:Name="TxtAgentInfo" FontSize="11.5" Margin="12,0,0,0"
                               Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center"
                               TextWrapping="Wrap" MaxWidth="300"/>
                </StackPanel>

                <TextBlock x:Name="TxtRoot" FontSize="11.5" Margin="0,6,0,0"
                           Foreground="{DynamicResource TextFaint}" TextWrapping="Wrap"/>
                <TextBlock x:Name="TxtSpec" FontSize="11.5" Margin="0,2,0,0"
                           Foreground="{DynamicResource TextFaint}" TextWrapping="Wrap"/>

                <!-- 整批渲染过程中的实时反馈（单镜重渲的反馈在右栏，各有各的） -->
                <StackPanel x:Name="ProgressRow" Visibility="Collapsed" Margin="0,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ProgressBar x:Name="BarRender" Height="8" IsIndeterminate="True" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" x:Name="TxtElapsed" FontSize="11.5"
                                   Foreground="{DynamicResource TextDim}" Margin="12,0,0,0"
                                   VerticalAlignment="Center" MinWidth="150"/>
                    </Grid>
                    <TextBlock x:Name="TxtProgress" FontSize="11.5"
                               Foreground="{DynamicResource TextDim}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                    <TextBlock x:Name="TxtLog" FontSize="11"
                               Foreground="{DynamicResource TextFaint}" Margin="0,4,0,0"
                               TextWrapping="Wrap" Visibility="Collapsed" FontFamily="Consolas"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ==================== 中部：三栏 ==================== -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="222"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="256"/>
                </Grid.ColumnDefinitions>

                <!-- ==== 左栏：镜头列表 ==== -->
                <Grid Grid.Column="0" Margin="10,10,6,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" x:Name="TxtListHint" FontSize="11"
                               Foreground="{DynamicResource TextFaint}" Margin="2,0,0,6"
                               TextWrapping="Wrap"/>
                    <ListBox Grid.Row="1" x:Name="ListShots" BorderThickness="0"
                             Background="Transparent"
                             ItemContainerStyle="{StaticResource ShotItem}"
                             ItemTemplate="{StaticResource TplRow}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             SelectionChanged="ListShots_SelectionChanged"/>
                </Grid>
                <Border Grid.Column="1" Background="{DynamicResource Border}"/>

                <!-- ==== 中栏：预览 + 微调 + 修改意见 ==== -->
                <Grid Grid.Column="2" x:Name="MidCol" Margin="10,10,10,10" SizeChanged="MidCol_SizeChanged">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 预览区：只有一个播放器（绝不 219 个一起挂，那是上次 C 盘崩盘的配方） -->
                    <Border Grid.Row="0" x:Name="PreviewBox" Background="{DynamicResource BgPreview}"
                            CornerRadius="6" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                            ClipToBounds="True" Height="240">
                        <Grid>
                            <MediaElement x:Name="Player" Stretch="Uniform"
                                          LoadedBehavior="Manual" UnloadedBehavior="Manual"
                                          ScrubbingEnabled="True"/>
                            <TextBlock x:Name="TxtNoVideo" Text="选中左边任意一镜，这里播放它已经渲好的 MP4"
                                       FontSize="12" Foreground="{DynamicResource TextFaint}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       TextWrapping="Wrap" TextAlignment="Center" Margin="30"/>
                            <Border x:Name="SubtitleBox" VerticalAlignment="Bottom" Background="{DynamicResource OverlayBg2}"
                                    Padding="12,7" Visibility="Collapsed">
                                <TextBlock x:Name="TxtSubtitle" Text="" FontSize="15" Foreground="{DynamicResource OnOverlay}"
                                           TextWrapping="Wrap" TextAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- 播放控制 -->
                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="上一镜" Style="{StaticResource Btn}" Click="BtnPrev_Click"
                                Padding="10,4,10,4" FontSize="12"
                                ToolTip="R 或 Alt+R = 上一镜（打字时除外）"/>
                        <Button Grid.Column="1" x:Name="BtnPlay" Content="播放" Style="{StaticResource Btn}"
                                Click="BtnPlay_Click" Padding="12,4,12,4" FontSize="12" Margin="5,0,0,0"
                                ToolTip="空格 = 播放/暂停（打字时除外）"/>
                        <Button Grid.Column="2" Content="下一镜" Style="{StaticResource Btn}" Click="BtnNext_Click"
                                Padding="10,4,10,4" FontSize="12" Margin="5,0,0,0"
                                ToolTip="F 或 Alt+F = 下一镜（打字时除外）"/>
                        <Button Grid.Column="3" x:Name="BtnLoop" Content="循环 开" Style="{StaticResource Btn}"
                                Click="BtnLoop_Click" Padding="10,4,10,4" FontSize="12" Margin="5,0,0,0"/>
                        <Slider Grid.Column="4" x:Name="Pos" Minimum="0" Maximum="1" Value="0"
                                VerticalAlignment="Center" Margin="10,0,6,0"
                                IsMoveToPointEnabled="True" SmallChange="0.02" LargeChange="0.2"
                                ValueChanged="Pos_ValueChanged"/>
                        <TextBlock Grid.Column="5" x:Name="TxtTime" Text="00.00 / 00.00" FontSize="11.5"
                                   Foreground="{DynamicResource TextDim}" VerticalAlignment="Center"
                                   MinWidth="94" TextAlignment="Right"/>
                    </Grid>

                    <!-- 微调 + 修改意见（滚动，窗口小的时候也够用） -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="口播文案" FontSize="11.5" Foreground="{DynamicResource TextFaint}"/>
                            <TextBox x:Name="TxtScript" Style="{StaticResource Tbx}" Height="48"
                                     TextWrapping="Wrap" AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto" Margin="0,3,0,0"
                                     TextChanged="TxtScript_TextChanged"/>

                            <TextBlock Text="画面构思" FontSize="11.5" Foreground="{DynamicResource TextFaint}"
                                       Margin="0,8,0,0"/>
                            <TextBox x:Name="TxtIdea" Style="{StaticResource Tbx}" Height="48"
                                     TextWrapping="Wrap" AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto" Margin="0,3,0,0"
                                     TextChanged="TxtIdea_TextChanged"/>

                            <TextBlock Text="动效" FontSize="11.5" Foreground="{DynamicResource TextFaint}"
                                       Margin="0,8,0,0"/>
                            <TextBox x:Name="TxtMotion" Style="{StaticResource Tbx}" Height="48"
                                     TextWrapping="Wrap" AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto" Margin="0,3,0,0"
                                     TextChanged="TxtMotion_TextChanged"/>

                            <!-- ★ 这一步的核心控件：不满意在哪，写在这儿 -->
                            <Border Background="{DynamicResource BgInput}" CornerRadius="6"
                                    BorderBrush="{DynamicResource Accent}" BorderThickness="1"
                                    Padding="9" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock FontSize="12.5" Foreground="{DynamicResource TextMain}" FontWeight="SemiBold">
                                        <Run Text="█ "/><Run Text="这一镜要改什么"/>
                                    </TextBlock>
                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextDim}"
                                               Margin="0,4,0,0" TextWrapping="Wrap"
                                               Text="写清楚哪儿不对（现象就行，做法我来判断）。这段话会原样交给 Agent：它会先读这一镜原来写好的代码，在原代码上改，然后只重渲这一镜。"/>

                                    <TextBlock Text="没头绪？点一个当开头：" FontSize="11"
                                               Foreground="{DynamicResource TextFaint}" Margin="0,7,0,3"/>
                                    <WrapPanel>
                                        <Button Content="节奏太赶" Style="{StaticResource Btn}" FontSize="11"
                                                Padding="8,3,8,3" Margin="0,0,5,5" Tag="节奏太赶，画面和文案都来不及看。"
                                                Click="Hint_Click"/>
                                        <Button Content="节奏太拖" Style="{StaticResource Btn}" FontSize="11"
                                                Padding="8,3,8,3" Margin="0,0,5,5" Tag="节奏太拖，后半段一直是静止画面。"
                                                Click="Hint_Click"/>
                                        <Button Content="字太小" Style="{StaticResource Btn}" FontSize="11"
                                                Padding="8,3,8,3" Margin="0,0,5,5" Tag="字太小，手机上看不清。"
                                                Click="Hint_Click"/>
                                        <Button Content="画面太素" Style="{StaticResource Btn}" FontSize="11"
                                                Padding="8,3,8,3" Margin="0,0,5,5" Tag="画面太素，只有文字，没有层次。"
                                                Click="Hint_Click"/>
                                        <Button Content="动效太乱" Style="{StaticResource Btn}" FontSize="11"
                                                Padding="8,3,8,3" Margin="0,0,5,5" Tag="动效太乱，元素太多，看着眼晕。"
                                                Click="Hint_Click"/>
                                        <Button Content="配图不合适" Style="{StaticResource Btn}" FontSize="11"
                                                Padding="8,3,8,3" Margin="0,0,5,5" Tag="配图和内容对不上，换一张更贴切的。"
                                                Click="Hint_Click"/>
                                        <Button Content="文字压边" Style="{StaticResource Btn}" FontSize="11"
                                                Padding="8,3,8,3" Margin="0,0,5,5" Tag="文字压到画面边缘了，留白不够。"
                                                Click="Hint_Click"/>
                                        <Button Content="和上一镜重复" Style="{StaticResource Btn}" FontSize="11"
                                                Padding="8,3,8,3" Margin="0,0,5,5" Tag="和前后镜的画面太像，看着像卡住了。"
                                                Click="Hint_Click"/>
                                    </WrapPanel>

                                    <TextBox x:Name="TxtNote" Style="{StaticResource Tbx}" Height="96"
                                             TextWrapping="Wrap" AcceptsReturn="True"
                                             VerticalScrollBarVisibility="Auto" Margin="0,6,0,0"
                                             TextChanged="TxtNote_TextChanged"/>
                                </StackPanel>
                            </Border>

                            <!-- 预设提示词：让用户看得见"我要交给 AI 的到底是什么" -->
                            <Expander x:Name="ExpPrompt" Header="AI 会收到什么（点开看这次重渲的完整提示词）"
                                      Foreground="{DynamicResource TextDim}" FontSize="11.5"
                                      Margin="0,10,0,0" Expanded="ExpPrompt_Expanded">
                                <StackPanel>
                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextFaint}"
                                               TextWrapping="Wrap" Margin="0,4,0,5"
                                               Text="里面刻意不复制这一镜的 HTML 源码，只给文件路径 —— 让 Agent 自己去读那个文件。这样每次重渲省下一大段重复的输入，也不会因为源码改过而照着过期副本改。"/>
                                    <TextBox x:Name="TxtPromptPreview" Style="{StaticResource Tbx}"
                                             IsReadOnly="True" Height="230" FontSize="10.5"
                                             FontFamily="Consolas" TextWrapping="Wrap"
                                             AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Disabled"/>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
                <Border Grid.Column="3" Background="{DynamicResource Border}"/>

                <!-- ==== 右栏：本镜状态 + 重渲 ==== -->
                <Grid Grid.Column="4" Margin="10,10,10,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="本镜状态" FontSize="11" Foreground="{DynamicResource TextFaint}"
                                   Margin="0,0,0,6"/>
                        <Border Background="{DynamicResource BgInput}" CornerRadius="6" Padding="8">
                            <StackPanel>
                                <TextBlock x:Name="TxtSelHead" Text="（未选中）" FontSize="13"
                                           Foreground="{DynamicResource TextMain}" FontWeight="SemiBold"/>
                                <TextBlock x:Name="TxtSelStatus" Text="" FontSize="11.5"
                                           Foreground="{DynamicResource TextDim}" Margin="0,3,0,0"
                                           TextWrapping="Wrap"/>
                                <TextBlock x:Name="TxtSelFiles" Text="" FontSize="10.5"
                                           Foreground="{DynamicResource TextFaint}" Margin="0,4,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                        <StackPanel>
                            <Button x:Name="BtnReshoot" Content="让 Agent 改这一镜" Style="{StaticResource BtnPrimary}"
                                    Click="BtnReshoot_Click" Padding="10,9,10,9" IsEnabled="False"/>
                            <TextBlock FontSize="10.5" Foreground="{DynamicResource TextFaint}"
                                       TextWrapping="Wrap" Margin="0,5,0,0"
                                       Text="会把「修改意见 + 这一镜原本的分镜设计 + 原 HTML 的路径」合成一张任务包，交给 Agent 在原代码上改并只重渲这一镜。没有修改意见也能重渲（只会做保守打磨）。"/>
                            <Button x:Name="BtnCancelRe" Content="取消这次重渲" Style="{StaticResource Btn}"
                                    Click="BtnCancelRe_Click" Padding="10,5,10,5" Margin="0,6,0,0"
                                    IsEnabled="False"/>

                            <!-- 重渲进度（跟整批渲染那套是分开的两件事） -->
                            <StackPanel x:Name="ReProgress" Visibility="Collapsed" Margin="0,10,0,0">
                                <ProgressBar x:Name="BarReshoot" Height="7" IsIndeterminate="True"/>
                                <TextBlock x:Name="TxtReElapsed" FontSize="11"
                                           Foreground="{DynamicResource TextDim}" Margin="0,5,0,0"
                                           TextWrapping="Wrap"/>
                                <TextBlock x:Name="TxtReProgress" FontSize="11"
                                           Foreground="{DynamicResource TextDim}" Margin="0,4,0,0"
                                           TextWrapping="Wrap"/>
                                <TextBlock x:Name="TxtReLog" FontSize="10.5" FontFamily="Consolas"
                                           Foreground="{DynamicResource TextFaint}" Margin="0,4,0,0"
                                           TextWrapping="Wrap" Visibility="Collapsed"/>
                            </StackPanel>

                            <Border Height="1" Background="{DynamicResource Border}" Margin="0,12,0,0"/>

                            <TextBlock Text="版本对比" FontSize="11" Foreground="{DynamicResource TextFaint}"
                                       Margin="0,10,0,6"/>
                            <TextBlock x:Name="TxtVerNow" Text="当前：—" FontSize="11.5"
                                       Foreground="{DynamicResource TextDim}" TextWrapping="Wrap"/>
                            <TextBlock x:Name="TxtVerPrev" Text="上一版：无" FontSize="11.5"
                                       Foreground="{DynamicResource TextDim}" TextWrapping="Wrap"
                                       Margin="0,3,0,0"/>
                            <Button x:Name="BtnPlayPrev" Content="看上一版（不进队列）"
                                    Style="{StaticResource Btn}" Click="BtnPlayPrev_Click"
                                    Padding="10,5,10,5" Margin="0,7,0,0" IsEnabled="False"
                                    ToolTip="播放这一镜重渲前的旧版（shot_NNN.prev.mp4），方便判断这次改好了还是改坏了"/>

                            <Border Height="1" Background="{DynamicResource Border}" Margin="0,12,0,0"/>

                            <TextBlock Text="这一镜的产物" FontSize="11" Foreground="{DynamicResource TextFaint}"
                                       Margin="0,10,0,6"/>
                            <TextBlock x:Name="TxtPaths" Text="" FontSize="10.5"
                                       Foreground="{DynamicResource TextFaint}" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                <Button Content="打开输出目录" Style="{StaticResource Btn}" Click="BtnOpenOut_Click"
                                        Padding="9,4,9,4" FontSize="11.5"/>
                                <Button Content="打开这一镜的 HTML" Style="{StaticResource Btn}"
                                        Click="BtnOpenHtml_Click" Padding="9,4,9,4" FontSize="11.5"
                                        Margin="5,0,0,0"/>
                            </StackPanel>
                            <Button x:Name="BtnGenThumbs" Content="生成/刷新缩略图" Style="{StaticResource Btn}"
                                    Click="BtnGenThumbs_Click" Padding="9,4,9,4" FontSize="11.5"
                                    Margin="0,5,0,0" HorizontalAlignment="Left"
                                    ToolTip="从已渲好的 MP4 抽帧做左栏小图（用引擎自带的 ffmpeg）"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>

        <!-- ==================== 底部：统计 ==================== -->
        <TextBlock Grid.Row="2" x:Name="TxtSummary" Margin="2,9,2,0" FontSize="11.5"
                   Foreground="{DynamicResource TextDim}" TextWrapping="Wrap"/>
    </Grid>
</UserControl>
