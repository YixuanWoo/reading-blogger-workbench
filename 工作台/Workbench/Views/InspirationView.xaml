<!-- ============================================================
     InspirationView.xaml - 灵感池
     ============================================================
     一条灵感 = 一个还没成项目的想法。列表形式，一条一行，右侧直接"立项"。
     ============================================================ -->
<UserControl x:Class="LiteCut.Workbench.Views.InspirationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BgDeep}"
             Foreground="{DynamicResource TextMain}">

    <DockPanel>

        <Border DockPanel.Dock="Top" Padding="20,16,20,14"
                Background="{DynamicResource BgShell}" BorderBrush="{DynamicResource Border}"
                BorderThickness="0,0,0,1">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="＋ 记一条灵感"
                        Click="BtnAdd_Click" VerticalAlignment="Center"
                        Style="{StaticResource BtnPrimary}" FontSize="12.5" Padding="14,6"/>
                <StackPanel>
                    <TextBlock Text="灵感" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextMain}"/>
                    <TextBlock Text="先记下来，想做了再一键立项 —— 立项后它就是一个正经项目了"
                               FontSize="11.5" Margin="0,4,0,0"
                               Foreground="{DynamicResource TextFaint}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <TextBlock x:Name="TxtEmpty" Visibility="Collapsed"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextAlignment="Center" FontSize="13" LineHeight="24"
                   Foreground="{DynamicResource TextFaint}"
                   Text="还没有灵感。&#x0a;&#x0a;点右上角「＋ 记一条灵感」开始。"/>

        <ScrollViewer x:Name="ScrollList" VerticalScrollBarVisibility="Auto"
                      Padding="20,16,20,16">
            <ItemsControl x:Name="ListItems">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,10" Padding="14,12,14,12"
                                Background="{DynamicResource BgCard}"
                                BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                CornerRadius="10">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                            VerticalAlignment="Center" Margin="12,0,0,0">
                                    <Button Content="立项" Click="BtnCreate_Click"
                                            Style="{StaticResource BtnPrimary}"
                                            FontSize="12" Padding="14,4" Margin="0,0,6,0"/>
                                    <Button Content="删除" Click="BtnDelete_Click"
                                            Style="{StaticResource BtnDanger}"
                                            FontSize="12" Padding="10,4"/>
                                </StackPanel>

                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontSize="14"
                                               FontWeight="SemiBold" Foreground="{DynamicResource TextMain}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Note}" FontSize="12"
                                               Margin="0,5,0,0" TextWrapping="Wrap"
                                               MaxHeight="52"
                                               Foreground="{DynamicResource TextDim}"
                                               Visibility="{Binding NoteVisibility}"/>
                                    <TextBlock Text="{Binding Meta}" FontSize="11"
                                               Margin="0,6,0,0"
                                               Foreground="{DynamicResource TextFaint}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
