<UserControl x:Class="LiteCut.Workbench.Views.Step4ExportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei">
    <Grid Margin="16,14,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 出片参数 -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="12,10,12,10" Margin="0,0,0,10">
            <StackPanel>
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- ★ 三个模式就是三条出口，各走各的：
                           画面成片 = 拼第④步渲好的镜头（源素材没画面也照样出视频）
                           音频成片 = 只把声音按决策重编，出 m4a
                           达芬奇XML = 只给时间线，不渲染 -->
                    <TextBlock Text="模式：" Foreground="{DynamicResource TextDim}"
                               FontSize="13" VerticalAlignment="Center"/>
                    <ComboBox x:Name="CmbMode" Width="248" Margin="6,0,0,0"
                              SelectionChanged="CmbMode_Changed">
                        <ComboBoxItem Content="画面成片（拼第④步渲染产物）" Tag="film"/>
                        <ComboBoxItem Content="音频成片（只出声音）" Tag="audio"/>
                        <ComboBoxItem Content="导出达芬奇 XML" Tag="xml"/>
                    </ComboBox>

                    <TextBlock Text="分辨率：" Foreground="{DynamicResource TextDim}"
                               FontSize="13" VerticalAlignment="Center" Margin="18,0,0,0"/>
                    <ComboBox x:Name="CmbRes" Width="120" Margin="6,0,0,0">
                        <ComboBoxItem Content="原始（不缩放）"/>
                        <ComboBoxItem Content="1920x1080"/>
                        <ComboBoxItem Content="1280x720"/>
                    </ComboBox>

                    <TextBlock Text="画质：" Foreground="{DynamicResource TextDim}"
                               FontSize="13" VerticalAlignment="Center" Margin="18,0,0,0"/>
                    <ComboBox x:Name="CmbQ" Width="110" Margin="6,0,0,0">
                        <ComboBoxItem Content="高（crf 18）" Tag="18"/>
                        <ComboBoxItem Content="标准（crf 20）" Tag="20"/>
                        <ComboBoxItem Content="快（crf 23）" Tag="23"/>
                    </ComboBox>

                    <Button x:Name="BtnGo" Content="开始出片" Style="{StaticResource BtnPrimary}"
                            Click="BtnGo_Click" Margin="24,0,0,0" Padding="20,7,20,7"/>
                </WrapPanel>

                <!-- 当前模式的说明：能不能出、吃到什么、还缺什么，一眼看清 -->
                <TextBlock x:Name="TxtModeHint" FontSize="12.5" Margin="0,8,0,0"
                           Foreground="{DynamicResource TextDim}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- ============================================================
             轻量剪辑区 —— 只在「画面成片」模式出现（2026-10-01 T-07b）
             ============================================================
             【为什么要有它】
               ⑤ 组接的本质是"逐块把画面裁/补到和该块音频一样长"。
               以前这一步是黑箱：点一个按钮、出片，至于哪块长了哪块短了、
               长了多少，用户看不到也管不了。极少数块想手动多留/少留几帧，
               只能去动渲染产物，很别扭。

               这个区把"逐块对齐"摊开给用户看：
                 · 音频段   —— 锁死，口播是基准，一个字都不能动；
                 · 画面实测 —— 探测得到，只读；
                 · Δ        —— 画面比音频长/短多少，异常标色；
                 · 微调 帧  —— 唯一能改的一列，±几帧，只动画面。
               调完点「对齐并组接」（或上面的「开始出片」），conform 照它执行。
             ============================================================ -->
        <Border Grid.Row="1" x:Name="PanelAlign" Style="{StaticResource Card}"
                Padding="12,10,12,10" Margin="0,0,0,10" Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="轻量剪辑 · 逐块对齐" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMain}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtAlignPolicy" FontSize="11.5"
                                   Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center"
                                   Margin="10,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnAlignScan" Content="逐块对齐预览" Style="{StaticResource Btn}"
                                Click="BtnAlignScan_Click" Padding="12,5,12,5"
                                ToolTip="逐块读出画面实测时长，和该块音频段长度比一比。只看不改任何文件。"/>
                        <Button x:Name="BtnAlignReset" Content="还原微调" Style="{StaticResource Btn}"
                                Click="BtnAlignReset_Click" Margin="6,0,0,0" Padding="12,5,12,5"
                                IsEnabled="False" ToolTip="把所有「微调 帧」归零，回到严格按音频长度对齐。"/>
                    </StackPanel>
                </Grid>

                <DataGrid Grid.Row="1" x:Name="GridAlign" MaxHeight="236" Margin="0,8,0,0"
                          SelectionMode="Single" FontSize="12">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="镜号" Binding="{Binding IndexText}"
                                            Width="70" IsReadOnly="True"/>
                        <DataGridTextColumn Header="音频段 (s)" Binding="{Binding AudioText}"
                                            Width="112" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
                                    <Setter Property="FontFamily" Value="Consolas"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="画面实测 (s)" Binding="{Binding ActualText}"
                                            Width="112" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
                                    <Setter Property="FontFamily" Value="Consolas"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Δ (s)" Binding="{Binding DeltaText}"
                                            Width="104" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{Binding DeltaBrush}"/>
                                    <Setter Property="FontFamily" Value="Consolas"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="微调 (帧)" Width="104"
                                            Binding="{Binding AdjustFrames, Mode=TwoWay}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                    <Setter Property="FontFamily" Value="Consolas"/>
                                    <Setter Property="TextAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                            <DataGridTextColumn.EditingElementStyle>
                                <Style TargetType="TextBox">
                                    <Setter Property="Background" Value="{DynamicResource BgInput}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
                                    <Setter Property="CaretBrush" Value="{DynamicResource TextMain}"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="TextAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.EditingElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="目标 (s)" Binding="{Binding TargetText}"
                                            Width="*" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
                                    <Setter Property="FontFamily" Value="Consolas"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Grid Grid.Row="2" Margin="0,8,0,0">
                    <TextBlock x:Name="TxtAlignSummary" FontSize="11.5"
                               Foreground="{DynamicResource TextDim}" VerticalAlignment="Center"
                               TextWrapping="Wrap" Margin="0,0,190,0"/>
                    <Button x:Name="BtnAssemble" Content="对齐并组接" Style="{StaticResource BtnPrimary}"
                            Click="BtnAssemble_Click" HorizontalAlignment="Right"
                            Padding="16,6,16,6"
                            ToolTip="按这张表逐块 conform 后组接出片（和上面的「开始出片」是同一件事）。"/>
                </Grid>
            </Grid>
        </Border>

        <!-- ============================================================
             结果区（2026-10-04 T-27 改成两个标签页）
               · 审片台 —— 只审最终成片：组装审片草稿 → 播放 → 打点标记
                 （时间 + 一句话）→ 自动回推是哪一镜 → 意见写回 shot-overrides
                 → 唤醒 Agent 重渲 → 改完重新组装。循环到满意才走上面的正式导出。
               · 出片记录 —— 组接/导出的过程日志（原来的样子，原样保留）。
             ============================================================ -->
        <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0">

            <TabItem Header="审片台">
                <Border Style="{StaticResource Card}" Margin="0,8,0,0" Padding="12,10,12,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- ① 组装审片成片 -->
                        <Grid Grid.Row="0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnDraft" Content="① 组装审片成片" Style="{StaticResource BtnPrimary}"
                                        Click="BtnDraft_Click" Padding="14,6,14,6"
                                        ToolTip="把第④步渲好的镜头按当前决策拼成一版完整的成片（固定落在项目 05-assemble\审片-draft.mp4，crf 18，不弹对话框）。改过镜头后重新点一次就是新版本。"/>
                                <TextBlock x:Name="TxtDraftState" FontSize="11.5" Margin="10,0,0,0"
                                           Foreground="{DynamicResource TextDim}" VerticalAlignment="Center"
                                           TextWrapping="Wrap" MaxWidth="620"/>
                            </StackPanel>
                        </Grid>

                        <!-- ② 播放器 -->
                        <Grid Grid.Row="1" Margin="0,8,0,0">
                            <Border Background="{DynamicResource BgInset2}" CornerRadius="4">
                                <Grid>
                                    <MediaElement x:Name="ReviewPlayer" LoadedBehavior="Manual"
                                                  UnloadedBehavior="Stop" ScrubbingEnabled="True"
                                                  Stretch="Uniform"/>
                                    <TextBlock x:Name="TxtNoFilm" Text="还没有审片成片 —— 点上面的「① 组装审片成片」"
                                               Foreground="{DynamicResource TextFaint}" FontSize="13"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- ③ 播放控制 -->
                        <Grid Grid.Row="2" Margin="0,6,0,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnPlay" Content="▶ 播放" Style="{StaticResource Btn}"
                                        Click="BtnPlay_Click" Width="84" Padding="8,4,8,4"
                                        ToolTip="空格 = 播放/暂停（打意见时除外）。"/>
                                <TextBlock x:Name="TxtTime" Text="0:00 / 0:00" FontFamily="Consolas"
                                           FontSize="12" Foreground="{DynamicResource TextDim}"
                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                                <TextBlock Text="速度：" Foreground="{DynamicResource TextDim}" FontSize="12"
                                           VerticalAlignment="Center" Margin="12,0,0,0"/>
                                <ComboBox x:Name="CmbSpeed" Width="74" FontSize="12"
                                          SelectionChanged="CmbSpeed_Changed">
                                    <ComboBoxItem Content="1.0×" Tag="1.0"/>
                                    <ComboBoxItem Content="1.25×" Tag="1.25"/>
                                    <ComboBoxItem Content="1.5×" Tag="1.5"/>
                                    <ComboBoxItem Content="2.0×" Tag="2.0"/>
                                </ComboBox>
                            </StackPanel>
                            <Slider x:Name="SldSeek" Minimum="0" Maximum="100"
                                    VerticalAlignment="Center" Margin="280,0,12,0"
                                    Thumb.DragStarted="SldSeek_DragStarted"
                                    Thumb.DragCompleted="SldSeek_DragCompleted"/>
                        </Grid>

                        <!-- ④ 打点行 -->
                        <Grid Grid.Row="3" Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnMark" Content="⬖ 在此处打点" Style="{StaticResource BtnPrimary}"
                                        Click="BtnMark_Click" Padding="12,5,12,5"
                                        ToolTip="记住播放器此刻的时间点，配合右边的意见框，一起记进标记清单。"/>
                                <TextBlock Text="这一处有什么问题：" Foreground="{DynamicResource TextDim}"
                                           FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                <TextBox x:Name="TxtMarkNote" Width="380" Style="{StaticResource Tbx}"
                                         FontSize="12" KeyDown="TxtMarkNote_KeyDown"
                                         ToolTip="一句话说清问题（太素了 / 字看不清 / 出场太慢…），回车=打点。留空也可以，Agent 会做保守打磨。"/>
                            </StackPanel>
                        </Grid>

                        <!-- ⑤ 标记清单 -->
                        <DataGrid Grid.Row="4" x:Name="GridMarkers" MaxHeight="150" Margin="0,8,0,0"
                                  SelectionMode="Single" FontSize="12" HeadersVisibility="Column"
                                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="时间" Binding="{Binding TimeText}" Width="86">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
                                            <Setter Property="FontFamily" Value="Consolas"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="镜号" Binding="{Binding ShotText}" Width="76">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                            <Setter Property="FontFamily" Value="Consolas"/>
                                            <Setter Property="TextAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="意见" Binding="{Binding Note}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
                                            <Setter Property="TextWrapping" Value="Wrap"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="130">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{Binding StatusBrush}"/>
                                            <Setter Property="TextAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="操作" Width="64">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="删" Style="{StaticResource Btn}" Padding="6,1,6,1"
                                                    FontSize="11" Click="BtnMarkerDel_Click"
                                                    Tag="{Binding}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- ⑥ 底部动作 -->
                        <Grid Grid.Row="5" Margin="0,8,0,0">
                            <TextBlock x:Name="TxtMarkSummary" FontSize="11.5"
                                       Foreground="{DynamicResource TextDim}" VerticalAlignment="Center"
                                       TextWrapping="Wrap" Margin="0,0,420,0"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="BtnNotesWrite" Content="② 意见写入第④页" Style="{StaticResource Btn}"
                                        Click="BtnNotesWrite_Click" Padding="12,5,12,5" IsEnabled="False"
                                        ToolTip="把标记清单里的意见合并进 shot-overrides.json（渲染页的「修改意见」框）——只写意见不重渲时用。"/>
                                <Button x:Name="BtnSendReshoot" Content="③ 唤醒 Agent 重渲" Style="{StaticResource BtnPrimary}"
                                        Click="BtnSendReshoot_Click" Padding="14,5,14,5" IsEnabled="False" Margin="8,0,0,0"
                                        ToolTip="把标记的意见写进第④页，并给 Agent 发一份批量单镜重渲任务包（一次带所有标记过的镜头）。改完回这里重新「组装审片成片」。"/>
                                <Button x:Name="BtnMarkClear" Content="清空标记" Style="{StaticResource Btn}"
                                        Click="BtnMarkClear_Click" Padding="12,5,12,5" Margin="8,0,0,0"
                                        ToolTip="删掉全部标记（意见已写入第④页的不会被删）。"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </TabItem>

            <TabItem Header="出片记录">
                <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="出片记录" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMain}" Margin="0,0,0,8"/>

                        <TextBox Grid.Row="1" x:Name="TxtLog" Style="{StaticResource Tbx}"
                                 AcceptsReturn="True" IsReadOnly="True"
                                 VerticalScrollBarVisibility="Auto" FontFamily="Consolas"
                                 FontSize="12" TextWrapping="Wrap"
                                 Background="{DynamicResource BgNav}"/>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>

        <!-- 底部 -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="12,10,12,10">
            <Grid>
                <TextBlock x:Name="TxtResult" FontSize="12.5"
                           Foreground="{DynamicResource TextDim}" VerticalAlignment="Center"
                           TextWrapping="Wrap" Margin="0,0,320,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnOpenOut" Content="打开输出文件" Style="{StaticResource Btn}"
                            Click="BtnOpenOut_Click" IsEnabled="False" Padding="14,6,14,6"
                            Margin="0,0,8,0"/>
                    <Button x:Name="BtnReveal" Content="打开所在目录" Style="{StaticResource Btn}"
                            Click="BtnReveal_Click" IsEnabled="False" Padding="14,6,14,6"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
