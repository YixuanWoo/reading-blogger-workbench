<!-- ============================================================
     SettingsWindow.xaml - ★ V1.14.0 设置
     ============================================================
     三类设置，左侧切换：
       ① 大模型配置 —— 直连大模型的地址 / 密钥 / 模型（原先藏在分镜页的弹窗里）
       ② 路径配置   —— 项目默认路径、ffmpeg、渲染引擎、模板库、归档落点……
                        （以前这些写死在代码里，想换地方只能改代码）
       ③ 调试       —— 调试模式开关（界面操作全部记日志 + 开本机遥控口）

     所有改动都是「点了保存才生效」—— 取消就什么都不写。
     ============================================================ -->
<Window x:Class="LiteCut.Workbench.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Height="680" Width="880"
        MinHeight="520" MinWidth="780"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgDeep}"
        Foreground="{DynamicResource TextMain}"
        FontFamily="Microsoft YaHei"
        ShowInTaskbar="False">

    <!-- ============================================================
         ★ V1.18.0 主题卡片样式
         ============================================================
         为什么用 RadioButton 而不是 ListBox：
           这是个"二选一（以后可能三选一）"，RadioButton 天然带分组语义，
           键盘也能用方向键选。外观整张卡片自己做模板，选中态用左侧竖条 +
           描边（跟导航菜单同一套语言，见 skill 里"选中态要自己画"那条）。 -->
    <Window.Resources>
        <Style x:Key="ThemeCard" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{DynamicResource BgCard}"
                                BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                CornerRadius="10" Padding="14,12"
                                Width="268">
                            <StackPanel>
                                <ContentPresenter/>
                                <Border x:Name="Pick" Height="3" CornerRadius="2"
                                        Background="Transparent" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BorderHover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgCardAlt}"/>
                                <Setter TargetName="Pick" Property="Background" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ 左：分类 ============ -->
        <Border Grid.Column="0" Background="{DynamicResource BgNav}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
            <StackPanel>
                <TextBlock Text="设置" FontSize="17" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextMain}" Margin="18,20,18,14"/>

                <RadioButton x:Name="CatTheme" Content="外观主题" GroupName="SetCat"
                             Style="{StaticResource NavBtn}"
                             Checked="Cat_Checked" Tag="theme"/>
                <RadioButton x:Name="CatLlm" Content="大模型配置" GroupName="SetCat"
                             Style="{StaticResource NavBtn}" IsChecked="True"
                             Checked="Cat_Checked" Tag="llm"/>
                <RadioButton x:Name="CatPaths" Content="路径配置" GroupName="SetCat"
                             Style="{StaticResource NavBtn}"
                             Checked="Cat_Checked" Tag="paths"/>
                <RadioButton x:Name="CatDebug" Content="调试" GroupName="SetCat"
                             Style="{StaticResource NavBtn}"
                             Checked="Cat_Checked" Tag="debug"/>

                <TextBlock Margin="18,22,18,0" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFaint}"
                           Text="这里的设置是全局的（对所有项目生效），存在 %APPDATA%\翊瑄的工作台\config.json。"/>
            </StackPanel>
        </Border>

        <!-- ============ 右：内容 ============ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="22,20,22,20">
                <Grid>

                    <!-- ==================== ⓪ 外观主题（V1.18.0） ==================== -->
                    <StackPanel x:Name="PageTheme" Visibility="Collapsed">
                        <TextBlock Text="外观主题" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMain}"/>
                        <TextBlock Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextDim}"
                                   Text="选一套界面配色。点一下就能当场看到效果；点「保存设置」才会记住，点「取消」会还原。"/>

                        <!-- 两张主题卡片。★ 色块是**预览**，故意写死两套主题各自的颜色 ——
                             不能引用主题资源，否则预览永远显示当前这套，就分不出区别了。 -->
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">

                            <!-- 夜空黑 -->
                            <RadioButton x:Name="RbNight" Style="{StaticResource ThemeCard}"
                                         GroupName="ThemePick" Tag="night"
                                         Checked="Theme_Checked">
                                <StackPanel>
                                    <TextBlock Text="夜空黑" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextMain}"/>
                                    <TextBlock Text="原来的配色 · 深底亮字 · 夜里不刺眼"
                                               FontSize="11" Margin="0,4,0,10"
                                               Foreground="{DynamicResource TextFaint}"/>
                                    <Border CornerRadius="6" Height="74" Background="#FF0E1013"
                                            BorderBrush="#FF2A3038" BorderThickness="1">
                                        <StackPanel Margin="10,9">
                                            <Border Height="14" CornerRadius="3" Background="#FF1A1E24"/>
                                            <Border Height="8" CornerRadius="3" Background="#FF2A3038"
                                                    Width="120" HorizontalAlignment="Left" Margin="0,7,0,0"/>
                                            <Border Height="8" CornerRadius="3" Background="#FFE6E9EF"
                                                    Width="72" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Border Width="22" Height="12" CornerRadius="2" Background="#FF3B82F6"/>
                                        <Border Width="22" Height="12" CornerRadius="2" Background="#FF22C55E" Margin="4,0,0,0"/>
                                        <Border Width="22" Height="12" CornerRadius="2" Background="#FFF59E0B" Margin="4,0,0,0"/>
                                        <Border Width="22" Height="12" CornerRadius="2" Background="#FFEF4444" Margin="4,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </RadioButton>

                            <!-- 晨光白 -->
                            <RadioButton x:Name="RbDay" Style="{StaticResource ThemeCard}"
                                         GroupName="ThemePick" Tag="day"
                                         Checked="Theme_Checked">
                                <StackPanel>
                                    <TextBlock Text="晨光白" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextMain}"/>
                                    <TextBlock Text="明亮清新 · 白底深字 · 白天不累眼"
                                               FontSize="11" Margin="0,4,0,10"
                                               Foreground="{DynamicResource TextFaint}"/>
                                    <Border CornerRadius="6" Height="74" Background="#FFEEF2F7"
                                            BorderBrush="#FFD7DFE9" BorderThickness="1">
                                        <StackPanel Margin="10,9">
                                            <Border Height="14" CornerRadius="3" Background="#FFFFFFFF"/>
                                            <Border Height="8" CornerRadius="3" Background="#FFD7DFE9"
                                                    Width="120" HorizontalAlignment="Left" Margin="0,7,0,0"/>
                                            <Border Height="8" CornerRadius="3" Background="#FF1F2933"
                                                    Width="72" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Border Width="22" Height="12" CornerRadius="2" Background="#FF2563EB"/>
                                        <Border Width="22" Height="12" CornerRadius="2" Background="#FF16A34A" Margin="4,0,0,0"/>
                                        <Border Width="22" Height="12" CornerRadius="2" Background="#FFB45309" Margin="4,0,0,0"/>
                                        <Border Width="22" Height="12" CornerRadius="2" Background="#FFD92D20" Margin="4,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>

                        <Border Margin="0,18,0,0" Padding="14,12" CornerRadius="8"
                                Background="{DynamicResource BgCard}"
                                BorderBrush="{DynamicResource Border}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock x:Name="TxtThemeState" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextDim}"/>
                                <TextBlock Margin="0,8,0,0" FontSize="11.5" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFaint}"
                                           Text="这套配色是全程序共用的：项目列表、写作台、精剪波形、分镜卡、渲染审阅台、录音台都会跟着变。视频画面和渲染产物不受影响（那是成片规格，不是界面配色）。"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ==================== ① 大模型配置 ==================== -->
                    <StackPanel x:Name="PageLlm">
                        <TextBlock Text="大模型配置" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextMain}"/>
                        <TextBlock Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextDim}"
                                   Text="工作台自己调大模型就用这一份配置（分镜设计、镜头渲染都走它）。填了地址和密钥就走「直连」，进度条是真的在动；留空则退回「任务包文件」通道 —— 把任务写到项目里、等外部 Agent 来领。"/>

                        <TextBlock Text="接口地址（OpenAI 兼容，一般填到 /v1）"
                                   FontSize="12" Margin="0,16,0,4" Foreground="{DynamicResource TextDim}"/>
                        <TextBox x:Name="TxtUrl" Style="{StaticResource Tbx}"/>

                        <TextBlock Text="API Key" FontSize="12" Margin="0,12,0,4"
                                   Foreground="{DynamicResource TextDim}"/>
                        <PasswordBox x:Name="TxtKey" FontSize="13" Padding="8,6"
                                     Background="{DynamicResource BgInput}"
                                     Foreground="{DynamicResource TextMain}"
                                     BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                     CaretBrush="{DynamicResource TextMain}"/>

                        <TextBlock Text="模型名（如 deepseek-chat / gpt-4o-mini / 本地模型名）"
                                   FontSize="12" Margin="0,12,0,4" Foreground="{DynamicResource TextDim}"/>
                        <TextBox x:Name="TxtModel" Style="{StaticResource Tbx}"/>

                        <CheckBox x:Name="ChkStream" Content="流式（能看到逐字进度，推荐）"
                                  FontSize="12.5" Margin="0,14,0,0"
                                  Foreground="{DynamicResource TextMain}"/>

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button x:Name="BtnTestLlm" Content="检测连接"
                                    Style="{StaticResource Btn}" FontSize="12.5"
                                    Click="BtnTestLlm_Click"/>
                            <TextBlock Text="← 填完先测一下，别等正式调用才发现配置错了"
                                       FontSize="11.5" Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFaint}"/>
                        </StackPanel>

                        <TextBlock x:Name="TxtLlmResult" FontSize="12.5" Margin="0,8,0,0"
                                   TextWrapping="Wrap" Foreground="{DynamicResource TextDim}"/>
                    </StackPanel>

                    <!-- ==================== ② 路径配置 ==================== -->
                    <StackPanel x:Name="PagePaths" Visibility="Collapsed">
                        <TextBlock Text="路径配置" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextMain}"/>
                        <TextBlock Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextDim}"
                                   Text="以前这些路径写死在代码里，想换个位置只能改代码重新编译。现在都在这里改。留空的项＝用默认值（默认值都指向 exe 旁边那个文件夹，整个软件夹拷走就能用）。"/>

                        <!-- 项目默认路径 -->
                        <Border Margin="0,16,0,0" Padding="14,12" CornerRadius="8"
                                Background="{DynamicResource BgCard}"
                                BorderBrush="{DynamicResource Border}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="★ 项目默认路径" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMain}"/>
                                <TextBlock Margin="0,4,0,8" FontSize="11.5" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFaint}"
                                           Text="每个项目是它下面的一个子文件夹。新建项目、项目列表，全部以这里为根。"/>

                                <TextBox x:Name="TxtProjectRoot" Style="{StaticResource Tbx}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="浏览…" Style="{StaticResource Btn}" FontSize="12"
                                            Padding="10,4" Click="BrowseProjectRoot_Click"/>
                                    <Button Content="用默认值" Style="{StaticResource Btn}" FontSize="12"
                                            Padding="10,4" Margin="6,0,0,0" Click="ResetProjectRoot_Click"/>
                                    <Button Content="打开" Style="{StaticResource Btn}" FontSize="12"
                                            Padding="10,4" Margin="6,0,0,0" Click="OpenProjectRoot_Click"/>
                                    <TextBlock x:Name="TxtProjectRootNow" FontSize="11.5" Margin="10,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFaint}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="其它重要路径" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMain}" Margin="0,20,0,0"/>
                        <TextBlock Margin="0,4,0,0" FontSize="11.5" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFaint}"
                                   Text="下面这几项一般不用改 —— 只有换了电脑、换了硬盘位置才需要动。"/>

                        <!-- ffmpeg -->
                        <TextBlock Text="ffmpeg.exe" FontSize="12" Margin="0,14,0,4"
                                   Foreground="{DynamicResource TextDim}"/>
                        <TextBox x:Name="TxtFfmpeg" Style="{StaticResource Tbx}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="浏览…" Style="{StaticResource Btn}" FontSize="12"
                                    Padding="10,4" Click="BrowseFfmpeg_Click"/>
                            <Button Content="自动检测" Style="{StaticResource Btn}" FontSize="12"
                                    Padding="10,4" Margin="6,0,0,0" Click="AutoFfmpeg_Click"/>
                            <TextBlock x:Name="TxtFfmpegNow" FontSize="11.5" Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFaint}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <!-- 素材种子 -->
                        <TextBlock Text="立项素材种子目录（新建项目时从这复制素材）"
                                   FontSize="12" Margin="0,14,0,4" Foreground="{DynamicResource TextDim}"/>
                        <TextBox x:Name="TxtSeed" Style="{StaticResource Tbx}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="浏览…" Style="{StaticResource Btn}" FontSize="12"
                                    Padding="10,4" Click="BrowseSeed_Click"/>
                            <Button Content="用默认值" Style="{StaticResource Btn}" FontSize="12"
                                    Padding="10,4" Margin="6,0,0,0" Click="ResetSeed_Click"/>
                        </StackPanel>

                        <!-- HyperFrames 引擎根 -->
                        <TextBlock Text="渲染引擎根目录（HyperFrames 本体）"
                                   FontSize="12" Margin="0,14,0,4" Foreground="{DynamicResource TextDim}"/>
                        <TextBox x:Name="TxtRenderRoot" Style="{StaticResource Tbx}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="浏览…" Style="{StaticResource Btn}" FontSize="12"
                                    Padding="10,4" Click="BrowseRenderRoot_Click"/>
                        </StackPanel>

                        <!-- 模板库 -->
                        <TextBlock Text="动效模板库目录"
                                   FontSize="12" Margin="0,14,0,4" Foreground="{DynamicResource TextDim}"/>
                        <TextBox x:Name="TxtTemplateDir" Style="{StaticResource Tbx}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="浏览…" Style="{StaticResource Btn}" FontSize="12"
                                    Padding="10,4" Click="BrowseTemplateDir_Click"/>
                        </StackPanel>

                        <!-- 归档落点 -->
                        <TextBlock Text="归档落点根目录（归档时项目整包搬到这）"
                                   FontSize="12" Margin="0,14,0,4" Foreground="{DynamicResource TextDim}"/>
                        <TextBox x:Name="TxtArchiveRoot" Style="{StaticResource Tbx}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="浏览…" Style="{StaticResource Btn}" FontSize="12"
                                    Padding="10,4" Click="BrowseArchiveRoot_Click"/>
                        </StackPanel>

                        <!-- 转写兜底 -->
                        <TextBlock Text="转写稿兜底目录（只在没打开项目时用）"
                                   FontSize="12" Margin="0,14,0,8" Foreground="{DynamicResource TextDim}"/>
                        <TextBox x:Name="TxtTranscript" Style="{StaticResource Tbx}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="浏览…" Style="{StaticResource Btn}" FontSize="12"
                                    Padding="10,4" Click="BrowseTranscript_Click"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- ==================== ③ 调试 ==================== -->
                    <StackPanel x:Name="PageDebug" Visibility="Collapsed">
                        <TextBlock Text="调试模式" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextMain}"/>
                        <TextBlock Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextDim}"
                                   Text="打开之后，工作台会做两件事：① 把界面上发生的每一件事（点了哪个按钮、改了哪个输入框、换了哪一页、哪些文件被创建/修改/删除）写进一份日志；② 在本机开一个只给 127.0.0.1 用的「遥控口」，让 AI 可以直接查控件清单、点按钮、填输入框 —— 像真人一样操作软件，不必靠截图猜。"/>

                        <Border Margin="0,16,0,0" Padding="14,12" CornerRadius="8"
                                Background="{DynamicResource BgCard}"
                                BorderBrush="{DynamicResource Border}" BorderThickness="1">
                            <StackPanel>
                                <CheckBox x:Name="ChkDebug" FontSize="13.5" Foreground="{DynamicResource TextMain}"
                                          Content="打开调试模式"
                                          Checked="ChkDebug_Changed" Unchecked="ChkDebug_Changed"/>
                                <TextBlock Margin="0,6,0,0" FontSize="11.5" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFaint}"
                                           Text="默认关着。它只在本机开端口（外网连不进来），退出工作台就自动关掉。"/>

                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <TextBlock Text="遥控口端口" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextDim}"/>
                                    <TextBox x:Name="TxtDebugPort" Style="{StaticResource Tbx}"
                                             Width="90" Margin="10,0,0,0"/>
                                    <TextBlock Text="（默认 18766；桥接占的是 18765，别撞上）"
                                               FontSize="11.5" Margin="10,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFaint}"/>
                                </StackPanel>

                                <CheckBox x:Name="ChkDebugFile" FontSize="12.5" Margin="0,12,0,0"
                                          Foreground="{DynamicResource TextMain}"
                                          Content="日志同时写文件（logs\debug_日期.log）"/>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,14,0,0" Padding="14,12" CornerRadius="8"
                                Background="{DynamicResource BgCard}"
                                BorderBrush="{DynamicResource Border}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="画面渲染" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMain}"/>
                                <CheckBox x:Name="ChkSoftwareRender" FontSize="13.5" Margin="0,10,0,0"
                                          Foreground="{DynamicResource TextMain}"
                                          Content="兼容渲染（不占用显卡）"
                                          Checked="ChkSoftwareRender_Changed"
                                          Unchecked="ChkSoftwareRender_Changed"/>
                                <TextBlock Margin="0,6,0,0" FontSize="11.5" TextWrapping="Wrap"
                                           LineHeight="18"
                                           Foreground="{DynamicResource TextFaint}"
                                           Text="遇到「整机卡住好几秒、任务管理器里 CPU/内存/磁盘却全是闲的」时打开它。打开后工作台不再使用显卡，画面改由 CPU 画好交给系统 —— 从物理上就不会再踩到显卡驱动那一条链。代价是滚动和动画没那么顺，CPU 会多一点点（这个界面是卡片和文字，够看）。"/>
                                <TextBlock x:Name="TxtRenderState" Margin="0,8,0,0" FontSize="11.5"
                                           TextWrapping="Wrap" Foreground="{DynamicResource TextDim}"/>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,14,0,0" Padding="14,12" CornerRadius="8"
                                Background="{DynamicResource BgCard}"
                                BorderBrush="{DynamicResource Border}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="当前状态" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMain}"/>
                                <TextBlock x:Name="TxtDebugStatus" Margin="0,8,0,0" FontSize="12"
                                           TextWrapping="Wrap" Foreground="{DynamicResource TextDim}"/>
                                <TextBlock x:Name="TxtDebugLogPath" Margin="0,6,0,0" FontSize="11.5"
                                           TextWrapping="Wrap" Foreground="{DynamicResource TextFaint}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="打开日志文件夹" Style="{StaticResource Btn}"
                                            FontSize="12" Padding="10,4" Click="OpenLogFolder_Click"/>
                                    <Button Content="刷新状态" Style="{StaticResource Btn}"
                                            FontSize="12" Padding="10,4" Margin="6,0,0,0"
                                            Click="RefreshDebugStatus_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,14,0,0" Padding="14,12" CornerRadius="8"
                                Background="{DynamicResource InfoBg}"
                                BorderBrush="{DynamicResource InfoBorder}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="遥控口怎么用（给 AI / 排障的人看）"
                                           FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource InfoText}"/>
                                <TextBlock Margin="0,8,0,0" FontSize="11.5" TextWrapping="Wrap"
                                           Foreground="{DynamicResource InfoText}" LineHeight="19"
                                           Text="GET /health　看状态与全部接口清单&#x0a;GET /ui/tree?filter=文字　列出屏幕上所有可点的按钮、输入框、下拉&#x0a;POST /ui/click　{&quot;label&quot;:&quot;应用到下游&quot;}　点一个按钮&#x0a;POST /ui/input　{&quot;id&quot;:&quot;TxtUrl&quot;,&quot;text&quot;:&quot;…&quot;}　往输入框打字&#x0a;POST /ui/nav　{&quot;id&quot;:&quot;step.shots&quot;}　跳到某一页&#x0a;GET /log?since=游标　读刚才发生了什么的流水账"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </Grid>
            </ScrollViewer>

            <!-- ============ 底部按钮 ============ -->
            <Border Grid.Row="1" Padding="18,12" Background="{DynamicResource BgShell}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
                <DockPanel>
                    <TextBlock x:Name="TxtHint" DockPanel.Dock="Left" FontSize="11.5"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFaint}"
                               Text="改完点「保存设置」生效。"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                DockPanel.Dock="Right">
                        <Button Content="保存设置" Style="{StaticResource BtnPrimary}"
                                FontSize="12.5" Padding="18,6" Margin="0,0,8,0"
                                Click="BtnSave_Click"/>
                        <Button Content="取消" Style="{StaticResource Btn}"
                                FontSize="12.5" Padding="14,6" Click="BtnCancel_Click"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
