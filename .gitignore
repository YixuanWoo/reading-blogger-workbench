# ============================================================
#  翊瑄的工作台（LiteCut）· 本地 git 忽略规则
# ------------------------------------------------------------
#  原则：只收「源码 + 文档 + 素材」。
#        构建产物 / 工具缓存 / 运行时日志 一律不收。
#
#  ★ 为什么必须忽略 bin/obj：
#    工程本体只有 6 MB 左右，而 build 完之后光 bin/obj 就有 190 MB。
#    把构建产物收进 git，仓库会瞬间胖 30 倍，而且每次编译都产生一堆
#    "什么都没改"的假改动 —— 这是本项目当初最需要 git 的原因。
# ============================================================

# ---- ① 构建产物（最大头）----
#  两个项目（LiteCut.Core / 工作台）和 工具\ 下三个小工具都有
[Bb]in/
[Oo]bj/

# ---- ② IDE / VS ----
.vs/
*.user
*.suo
*.userprefs
*.rsuser
*.sln.docstates

# ---- ③ Python 缓存（工具\ 下有一堆 .py 脚本）----
__pycache__/
*.py[cod]

# ---- ④ Node（工具\agent-bridge 是零依赖 Node 脚本，防手滑装了包）----
node_modules/

# ---- ⑤ 运行时日志 ----
#  ★ 工具\agent-bridge\bridge.log —— 桥接每次被唤醒都往里写一行，
#    是"运行时痕迹"不是源码，收进 git 只会天天假改动。
*.log

# ---- ⑥ 临时 / 备份 / 系统垃圾 ----
*.tmp
*.bak
*.cache
Thumbs.db
Desktop.ini
.DS_Store
